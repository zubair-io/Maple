+
+#[test]
+fn atmospheric_light_cutoff_ties_do_not_choose_a_spatial_color() {
+    let mut img = Image::new(1000, 1, ColorSpace::SceneLinearRec2020);
+    for (i, p) in img.pixels.iter_mut().enumerate() {
+        *p = if i < 500 {
+            [2.0, 1.0, 1.0]
+        } else {
+            [1.0, 4.0, 1.0]
+        };
+    }
+    // Both halves have minimum channel 1, so the REAL spatial dark
+    // channel is tied throughout; mirroring the scene cannot change A.
+    let mut dc = dark_channel(&img);
+    let a = atmospheric_light(&img, &dc);
+    img.pixels.reverse();
+    dc.reverse();
+    let b = atmospheric_light(&img, &dc);
+    for c in 0..3 {
+        assert!((a[c] - [1.5, 2.5, 1.0][c]).abs() < 1e-6, "{a:?}");
+        assert!((a[c] - b[c]).abs() < 1e-6, "{a:?} != {b:?}");
+    }
+}
+
+#[test]
+fn atmospheric_light_partial_tie_preserves_top_fraction_mass() {
+    let mut img = Image::new(2000, 1, ColorSpace::SceneLinearRec2020);
+    let mut dc = vec![0.1; 2000];
+    img.pixels[0] = [8.0, 1.0, 1.0];
+    img.pixels[1] = [0.8, 2.0, 0.8];
+    img.pixels[2] = [0.8, 0.8, 4.0];
+    dc[0] = 1.0;
+    dc[1] = 0.8;
+    dc[2] = 0.8;
+    let a = atmospheric_light(&img, &dc);
+    // top_n=2: one above the cutoff, then half of each tied position.
+    for c in 0..3 {
+        assert!((a[c] - [4.4, 1.2, 1.7][c]).abs() < 1e-6, "{a:?}");
+    }
+}
