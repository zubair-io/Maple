<Window
    x:Class="Maple.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Maple.WinUI.ViewModels"
    xmlns:conv="using:Maple.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Maple — Professional RAW Photo Editor">

    <Grid Background="{StaticResource MapleBg}" KeyboardAcceleratorPlacementMode="Hidden">

        <Grid.Resources>
            <conv:PickFlagVisibleConverter x:Key="PickVisible" />
            <conv:BoolVisibleConverter x:Key="BoolVisible" />
            <DataTemplate x:Key="SliderRowTemplate" x:DataType="vm:AdjustmentSliderViewModel">
                <StackPanel Margin="0,2,0,6" DoubleTapped="OnSliderRowDoubleTapped">
                    <Grid>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource MapleRowLabel}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource MaplePrimary}"
                                     Visibility="{Binding IsModified, Converter={StaticResource BoolVisible}}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormattedValue}" Style="{StaticResource MapleValueChip}" />
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                            StepFrequency="{Binding StepFrequency}"
                            Value="{Binding Value, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding Label}"
                            Margin="0,-4,0,0" IsThumbToolTipEnabled="False" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource MapleBg}"
                BorderBrush="{StaticResource MapleBorder}" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Style="{StaticResource MapleToolButton}" Click="OnToggleSidebar"
                            AutomationProperties.Name="Toggle sources panel">
                        <FontIcon Glyph="&#xE700;" FontSize="13" />
                    </Button>
                    <TextBlock Text="MAPLE" FontWeight="Bold" FontSize="15" CharacterSpacing="180"
                               VerticalAlignment="Center" Foreground="{StaticResource MaplePrimary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2"
                            VerticalAlignment="Center">
                    <Button x:Name="BrowseModeBtn" Click="OnSwitchToBrowse" Padding="16,5"
                            AutomationProperties.Name="Browse mode">
                        <TextBlock Text="Browse" FontWeight="SemiBold" FontSize="13" />
                    </Button>
                    <Button x:Name="DevelopModeBtn" Click="OnSwitchToDevelop" Padding="16,5"
                            AutomationProperties.Name="Develop mode">
                        <TextBlock Text="Develop" FontWeight="SemiBold" FontSize="13" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="190" PlaceholderText="Search name, camera, lens…"
                             Background="{StaticResource MapleInputBg}" FontSize="12"
                             TextChanged="OnSearchChanged"
                             AutomationProperties.Name="Search library" />
                    <Button Style="{StaticResource MapleToolButton}" Click="OnOpenDirectory"
                            ToolTipService.ToolTip="Add photo folder (Ctrl+O)"
                            AutomationProperties.Name="Add photo folder">
                        <FontIcon Glyph="&#xE8F4;" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource MapleToolButton}" Click="OnExportPhotos"
                            ToolTipService.ToolTip="Export JPEG (Ctrl+Shift+E)"
                            AutomationProperties.Name="Export photo">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                            <TextBlock Text="Export" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MapleToolButton}" Click="OnToggleInspector"
                            ToolTipService.ToolTip="Toggle inspector"
                            AutomationProperties.Name="Toggle inspector panel">
                        <FontIcon Glyph="&#xE90D;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Main three-column shell ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColDef" Width="260" MinWidth="0" MaxWidth="420" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="InspectorColDef" Width="320" MinWidth="0" MaxWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- Sources sidebar -->
            <Border Grid.Column="0" Background="{StaticResource MapleSidebar}"
                    BorderBrush="{StaticResource MapleBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="10,12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="LIBRARY" Style="{StaticResource MapleEyebrow}" Margin="8,0,0,6" />
                            <ListView x:Name="LibraryList" SelectionMode="Single" SelectedIndex="0"
                                      SelectionChanged="OnSelectLibraryScope">
                                <ListViewItem Tag="all">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{StaticResource MaplePrimary}" />
                                        <TextBlock Text="All Photos" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="pick">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4CAF50" />
                                        <TextBlock Text="Picks" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="reject">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource MapleErrorText}" />
                                        <TextBlock Text="Rejected" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="rated4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{StaticResource MapleStar}" />
                                        <TextBlock Text="4+ Stars" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListViewItem>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid Margin="8,0,4,6">
                                <TextBlock Text="FOLDERS" Style="{StaticResource MapleEyebrow}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Padding="4,2" Background="Transparent"
                                        BorderThickness="0" Click="OnOpenDirectory"
                                        AutomationProperties.Name="Add folder">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{StaticResource MapleTextMuted}" />
                                </Button>
                            </Grid>
                            <ListView x:Name="FoldersList" ItemsSource="{Binding LibraryFolders}"
                                      SelectionMode="Single" SelectionChanged="OnSelectFolder">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource MapleTextMuted}" />
                                            <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="TIMELINE" Style="{StaticResource MapleEyebrow}" Margin="8,0,0,6" />
                            <ListView ItemsSource="{Binding Timeline.DateGroups}" SelectionMode="Single"
                                      SelectionChanged="OnSelectTimelineGroup">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{StaticResource MapleTextMuted}" />
                                                <TextBlock Text="{Binding DateLabel}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PhotoCount}" FontSize="11"
                                                       Foreground="{StaticResource MapleTextMuted}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center: Browse grid / Develop viewport -->
            <Grid Grid.Column="1">
                <Grid x:Name="BrowseGridContainer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource MapleBorder}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ComboBox x:Name="FormatFilterBox" SelectedIndex="0" Width="120" FontSize="12"
                                      SelectionChanged="OnFormatFilterChanged"
                                      AutomationProperties.Name="Format filter">
                                <ComboBoxItem Content="All Formats" Tag="All" />
                                <ComboBoxItem Content="DNG" Tag="DNG" />
                                <ComboBoxItem Content="CR2" Tag="CR2" />
                                <ComboBoxItem Content="CR3" Tag="CR3" />
                                <ComboBoxItem Content="ARW" Tag="ARW" />
                                <ComboBoxItem Content="NEF" Tag="NEF" />
                            </ComboBox>
                            <ComboBox x:Name="RatingFilterBox" SelectedIndex="0" Width="120" FontSize="12"
                                      SelectionChanged="OnRatingFilterChanged"
                                      AutomationProperties.Name="Rating filter">
                                <ComboBoxItem Content="All Ratings" Tag="0" />
                                <ComboBoxItem Content="★ 3+" Tag="3" />
                                <ComboBoxItem Content="★ 4+" Tag="4" />
                                <ComboBoxItem Content="★ 5" Tag="5" />
                            </ComboBox>
                            <TextBlock x:Name="LibraryCountText" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MapleTextMuted}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <GridView x:Name="PhotoGrid" Grid.Row="1" ItemsSource="{Binding Photos}"
                              SelectionMode="Single" Padding="12" IsItemClickEnabled="True"
                              ItemClick="OnPhotoItemClick" SelectionChanged="OnGridSelectionChanged"
                              AutomationProperties.Name="Photo grid">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="180" Height="180" Margin="2" CornerRadius="4"
                                      AutomationProperties.Name="{Binding FileName}"
                                      Background="{StaticResource MapleSurface}">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="34" Foreground="{StaticResource MapleBorder}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                            Padding="5,1" CornerRadius="3" Background="#CC141210">
                                        <TextBlock Text="{Binding Format}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource MapleTextMuted}" />
                                    </Border>
                                    <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="6"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Visibility="{Binding FlagStatus, Converter={StaticResource PickVisible}}" />
                                    <Border VerticalAlignment="Bottom" Background="#B3141210" Padding="6,3">
                                        <Grid>
                                            <TextBlock Text="{Binding FileName}" FontSize="10"
                                                       Foreground="{StaticResource MapleTextMain}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,48,0" />
                                            <TextBlock Text="{Binding RatingStars}" FontSize="9"
                                                       Foreground="{StaticResource MapleStar}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <Grid x:Name="DevelopContainer" Visibility="Collapsed" Background="{StaticResource MapleImageCanvas}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource MapleBg}" Padding="12,5"
                            BorderBrush="{StaticResource MapleBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding SelectedPhoto.FileName}" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{StaticResource MapleTextMain}" />
                                <TextBlock Text="{Binding SelectedPhoto.Dimensions}" FontSize="11"
                                           Foreground="{StaticResource MapleTextMuted}" VerticalAlignment="Center" />
                                <ProgressRing IsActive="{Binding IsDecoding}" Width="14" Height="14" />
                                <TextBlock Text="{Binding DecodeStatus}" FontSize="11"
                                           Foreground="{StaticResource MapleWarn}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="RenderStatsText" FontSize="10" HorizontalAlignment="Right"
                                       Foreground="{StaticResource MapleTextMuted}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Image x:Name="ViewportImage" Stretch="Uniform" Margin="16"
                               AutomationProperties.Name="Rendered preview canvas" />
                    </Grid>

                    <Border Grid.Row="2" Height="80" Background="{StaticResource MapleBg}"
                            BorderBrush="{StaticResource MapleBorder}" BorderThickness="0,1,0,0" Padding="6,4">
                        <ListView x:Name="Filmstrip" ItemsSource="{Binding Photos}"
                                  SelectionMode="Single" SelectionChanged="OnGridSelectionChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  AutomationProperties.Name="Filmstrip">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="86" Height="60" Margin="2" CornerRadius="3"
                                          AutomationProperties.Name="{Binding FileName}"
                                          Background="{StaticResource MapleSurface}">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        <Ellipse Width="6" Height="6" Fill="#4CAF50" Margin="4"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Visibility="{Binding FlagStatus, Converter={StaticResource PickVisible}}" />
                                        <Border Background="#B3141210" VerticalAlignment="Bottom" Padding="3,1">
                                            <TextBlock Text="{Binding RatingStars}" FontSize="8"
                                                       Foreground="{StaticResource MapleStar}" HorizontalAlignment="Left" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>

            <!-- Detail inspector -->
            <Border Grid.Column="2" Background="{StaticResource MapleSurface}"
                    BorderBrush="{StaticResource MapleBorder}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Histogram + culling header, always visible -->
                    <StackPanel Grid.Row="0" Padding="12,10,12,0" Spacing="8">
                        <Border Height="72" CornerRadius="6" Background="{StaticResource MapleImageCanvas}"
                                BorderBrush="{StaticResource MapleBorder}" BorderThickness="1">
                            <Grid>
                                <Canvas x:Name="HistogramCanvas" Margin="4" />
                                <TextBlock Text="RGB HISTOGRAM" FontSize="8" Margin="6,4"
                                           Foreground="{StaticResource MapleTextMuted}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                        <Grid>
                            <StackPanel x:Name="StarRow" Orientation="Horizontal" Spacing="2" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                <Button x:Name="PickBtn" Style="{StaticResource MapleToolButton}" Padding="7,4"
                                        Click="OnFlagPick" ToolTipService.ToolTip="Pick (P)"
                                        AutomationProperties.Name="Flag as pick">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#4CAF50" />
                                </Button>
                                <Button x:Name="UnflagBtn" Style="{StaticResource MapleToolButton}" Padding="7,4"
                                        Click="OnFlagNone" ToolTipService.ToolTip="Unflag (U)"
                                        AutomationProperties.Name="Remove flag">
                                    <FontIcon Glyph="&#xE738;" FontSize="11" />
                                </Button>
                                <Button x:Name="RejectBtn" Style="{StaticResource MapleToolButton}" Padding="7,4"
                                        Click="OnFlagReject" ToolTipService.ToolTip="Reject (X)"
                                        AutomationProperties.Name="Flag as reject">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource MapleErrorText}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Tabs -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Padding="12,8">
                        <Button x:Name="TabDevelopBtn" Click="OnSelectInspectorTab" Padding="12,4" FontSize="12"
                                AutomationProperties.Name="Develop tab">Develop</Button>
                        <Button x:Name="TabInfoBtn" Click="OnSelectInspectorTab" Padding="12,4" FontSize="12"
                                AutomationProperties.Name="Info tab">Info</Button>
                    </StackPanel>

                    <!-- Develop tab -->
                    <ScrollViewer x:Name="AdjustmentsPanel" Grid.Row="2" Padding="12,0,12,12"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Style="{StaticResource MapleToolButton}" Padding="9,4" FontSize="11"
                                        Click="OnApplyAuto" ToolTipService.ToolTip="Auto adjustments"
                                        AutomationProperties.Name="Auto adjust">Auto</Button>
                                <Button Style="{StaticResource MapleToolButton}" Padding="9,4" FontSize="11"
                                        Click="OnRevert" ToolTipService.ToolTip="Revert to original (Ctrl+R)"
                                        AutomationProperties.Name="Revert edits">Revert</Button>
                                <ToggleSwitch Header="" OnContent="B&amp;W" OffContent="Color" FontSize="11"
                                              IsOn="{Binding BlackWhiteOn, Mode=TwoWay}" Margin="8,-6,0,0"
                                              AutomationProperties.Name="Black and white toggle" />
                            </StackPanel>

                            <ItemsControl x:Name="SectionsHost" ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AdjustmentSectionViewModel">
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  Header="{Binding Title}" IsExpanded="{Binding InitiallyExpanded}"
                                                  Margin="0,0,0,6">
                                            <ItemsControl ItemsSource="{Binding Sliders}"
                                                          ItemTemplate="{StaticResource SliderRowTemplate}" />
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="HSL" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{Binding HslBands}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HslBandViewModel">
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Band}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MapleTextMuted}" Margin="0,4,0,2" />
                                                <ContentControl Content="{Binding Hue}"
                                                                ContentTemplate="{StaticResource SliderRowTemplate}"
                                                                HorizontalContentAlignment="Stretch" />
                                                <ContentControl Content="{Binding Sat}"
                                                                ContentTemplate="{StaticResource SliderRowTemplate}"
                                                                HorizontalContentAlignment="Stretch" />
                                                <ContentControl Content="{Binding Lum}"
                                                                ContentTemplate="{StaticResource SliderRowTemplate}"
                                                                HorizontalContentAlignment="Stretch" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Info tab -->
                    <ScrollViewer x:Name="InfoPanel" Grid.Row="2" Padding="12,0,12,12" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <TextBlock Text="CAMERA" Style="{StaticResource MapleEyebrow}" />
                            <StackPanel x:Name="ExifRows" Spacing="6" />
                            <TextBlock Text="FILE" Style="{StaticResource MapleEyebrow}" Margin="0,8,0,0" />
                            <StackPanel x:Name="FileRows" Spacing="6" />
                            <Border Background="{StaticResource MapleSurfaceAlt}" Padding="8" CornerRadius="4"
                                    Margin="0,8,0,0">
                                <TextBlock Text="Edits persist to a non-destructive .xmp sidecar; the RAW file is never modified."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource MapleTextMuted}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
