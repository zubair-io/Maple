{
  "name": "maple-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build-raw-wasm": "bash ../raw-pipeline/raw-wasm/build.sh",
    "sync-raw-wasm": "bash scripts/sync-raw-wasm.sh",
    "raw-wasm": "npm run build-raw-wasm && npm run sync-raw-wasm",
    "prestart": "npm run raw-wasm",
    "prestart:maple": "npm run raw-wasm",
    "prestart:syrup": "npm run raw-wasm",
    "prebuild": "npm run raw-wasm",
    "prebuild:maple": "npm run raw-wasm",
    "prebuild:syrup": "npm run raw-wasm",
    "start": "npm run start:maple",
    "start:maple": "ng serve maple --port 4201",
    "start:syrup": "ng serve maple-syrup --port 4200",
    "build": "npm run build:maple",
    "build:maple": "ng build maple",
    "build:syrup": "ng build maple-syrup",
    "watch": "ng build maple --watch --configuration development",
    "format": "bash scripts/format.sh --write",
    "format:check": "bash scripts/format.sh --check",
    "test": "ng test",
    "e2e": "playwright test",
    "storybook": "ng run maple:storybook",
    "build-storybook": "ng run maple:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.10",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-fetch": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@simplewebauthn/browser": "^13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.11",
    "@angular/animations": "^21.2.0",
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@compodoc/compodoc": "^1.2.1",
    "@playwright/test": "^1.59.1",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/angular": "^10.4.0",
    "@tailwindcss/postcss": "^4",
    "fallow": "2.103.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.1",
    "storybook": "^10.4.0",
    "tailwindcss": "^4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
