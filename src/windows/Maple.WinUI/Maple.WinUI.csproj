<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\ExportFilmResources.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Maple.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Custom Program.Main: single-instance redirect for the maple-app://
         sign-in callback (see Program.cs). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Built from the canonical icon set (src/apple/.../AppIcon.appiconset)
         — regenerate with a multi-size repack if the artwork changes. -->
    <ApplicationIcon>Assets\maple.ico</ApplicationIcon>
    <!-- Display name: FileDescription drives the taskbar / Explorer label
         (the exe stays Maple.WinUI.exe). -->
    <AssemblyTitle>Maple</AssemblyTitle>
    <Product>Maple</Product>
    <Company>Just Maple</Company>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\maple.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Real QR encoding for the Maple.UI QR Code atom (MN4, #3053) —
         QRCoder is MIT-licensed, dependency-free netstandard2.0, and used
         only through the MuiQrMatrix seam so the module-matrix step stays
         unit-testable. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Diagnostic frame dumps (MAPLE_DUMP_FRAME) for the color parity checks. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls" Version="7.1.2" />
  </ItemGroup>

  <!-- Native Rust core: built by `cargo build - -release -p raw-ffi - -features gpu`
       in src/raw-pipeline (see ../scripts/build-windows.sh). Not committed. -->
  <ItemGroup Condition="Exists('..\..\raw-pipeline\target\release\raw_ffi.dll')">
    <None Include="..\..\raw-pipeline\target\release\raw_ffi.dll" Link="raw_ffi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Pano stitcher (#2583): `cargo build - -release -p maple-cli - -features pano`.
       Ships beside the app; PanoProvisioner also falls back to the repo
       target dir for development. -->
  <ItemGroup Condition="Exists('..\..\raw-pipeline\target\release\maple-cli.exe')">
    <None Include="..\..\raw-pipeline\target\release\maple-cli.exe" Link="maple-cli.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
