+
+// All eight noncentral patch distances are equal, so their Gaussian weights
+// and the maximum-neighbor center weight are equal. Their absolute magnitude
+// cancels: the normalized center must be 1/9, for any finite equal weights.
+#[test]
+fn equal_tiny_gaussian_weights_keep_the_normalized_nine_sample_mean() {
+    use super::{denoise_plane, NlmParams};
+    let mut plane = vec![0.0_f32; 9];
+    plane[4] = 1.0;
+    let expected = (1.0_f64 / 9.0) as f32;
+    for squared_distance_over_h2 in [8.0_f32, 16.0, 32.0, 64.0, 128.0, 1024.0] {
+        let params = NlmParams {
+            patch_radius: 0,
+            search_radius: 1,
+            h: squared_distance_over_h2.sqrt().recip(),
+        };
+        let actual = denoise_plane(&plane, 3, 3, params)[4];
+        assert!((actual - expected).abs() <= 5e-6,
+            "equal weights at exponent {squared_distance_over_h2}: expected {expected}, got {actual}");
+    }
+}
+
+#[test]
+fn normalized_extreme_impulses_agree_across_general_tiled_and_dynamic_paths() {
+    use super::{denoise_plane_cancellable, CancelToken};
+    for (w, h) in [(17, 17), (129, 129)] {
+        for exponent in [32.0_f32, 128.0, 1024.0] {
+            let mut plane = vec![0.02_f32; w * h];
+            let i = (h / 2) * w + w / 2;
+            plane[i] = 0.14;
+            let delta = plane[i] - plane[0];
+            let bandwidth = (2.0 * delta * delta / (25.0 * exponent)).sqrt();
+            let expected = (8.0 * plane[0] + plane[i]) / 9.0;
+            let fixed = denoise_plane(
+                &plane,
+                w,
+                h,
+                NlmParams {
+                    patch_radius: 2,
+                    search_radius: 1,
+                    h: bandwidth,
+                },
+            );
+            assert!(
+                (fixed[i] - expected).abs() < 2e-6,
+                "fixed {w} exponent{exponent}: {} != {expected}",
+                fixed[i]
+            );
+            let dynamic = denoise_plane_cancellable(
+                &plane,
+                w,
+                h,
+                NlmParams {
+                    patch_radius: 2,
+                    search_radius: 1,
+                    h: bandwidth / 0.1,
+                },
+                CancelToken::never(),
+                &vec![0.0; w * h],
+                Some(&[0.0; 6]),
+                100,
+                true,
+            );
+            assert!(
+                (dynamic[i] - expected).abs() < 2e-6,
+                "dynamic {w} exponent{exponent}: {} != {expected}",
+                dynamic[i]
+            );
+        }
+    }
+}
