{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "ea910103-47ad-40e0-a489-18cf7ac0ed76"
  },
  "newProjectRoot": "projects",
  "projects": {
    "maple-syrup": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/maple-syrup",
      "sourceRoot": "projects/maple-syrup/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/maple-syrup",
            "browser": "projects/maple-syrup/src/main.ts",
            "tsConfig": "projects/maple-syrup/tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/maple-syrup/public"
              },
              {
                "glob": "**/*",
                "input": "projects/maple-common/src/assets/brand",
                "output": "assets/brand"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/maple-common/src/assets/brand",
                "output": "/"
              },
              {
                "glob": "**/*.woff2",
                "input": "projects/maple-common/src/assets/fonts",
                "output": "/assets/fonts"
              },
              {
                "glob": "manifest.webmanifest",
                "input": "projects/maple-syrup/src",
                "output": "/"
              },
              {
                "glob": "raw_wasm_bg.wasm",
                "input": "projects/maple-common/src/lib/raw-pipeline/pkg",
                "output": "/"
              },
              {
                "glob": "**/workerHelpers.js",
                "input": "projects/maple-common/src/lib/raw-pipeline/pkg",
                "output": "/pkg"
              },
              {
                "glob": "workerHelpers.worker.js",
                "input": "projects/maple-common/src/lib/raw-pipeline/pkg",
                "output": "/pkg"
              },
              {
                "glob": "raw_wasm.js",
                "input": "projects/maple-common/src/lib/raw-pipeline/pkg",
                "output": "/pkg"
              }
            ],
            "styles": ["projects/maple-syrup/src/styles.scss"],
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3MB",
                  "maximumError": "8MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "headers": {
              "Cross-Origin-Opener-Policy": "same-origin",
              "Cross-Origin-Embedder-Policy": "require-corp"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "maple-syrup:build:production"
            },
            "development": {
              "buildTarget": "maple-syrup:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "maple": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/maple",
      "sourceRoot": "projects/maple/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/maple",
            "browser": "projects/maple/src/main.ts",
            "tsConfig": "projects/maple/tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/maple/public"
              },
              {
                "glob": "**/*",
                "input": "projects/maple-common/src/assets/brand",
                "output": "assets/brand"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/maple-common/src/assets/brand",
                "output": "/"
              },
              {
                "glob": "**/*.woff2",
                "input": "projects/maple-common/src/assets/fonts",
                "output": "/assets/fonts"
              },
              {
                "glob": "manifest.webmanifest",
                "input": "projects/maple/src",
                "output": "/"
              },
              {
                "glob": "raw_wasm_bg.wasm",
                "input": "projects/maple-common/src/lib/raw-pipeline/pkg",
                "output": "/"
              },
              {
                "glob": "**/workerHelpers.js",
                "input": "projects/maple-common/src/lib/raw-pipeline/pkg",
                "output": "/pkg"
              },
              {
                "glob": "workerHelpers.worker.js",
                "input": "projects/maple-common/src/lib/raw-pipeline/pkg",
                "output": "/pkg"
              },
              {
                "glob": "raw_wasm.js",
                "input": "projects/maple-common/src/lib/raw-pipeline/pkg",
                "output": "/pkg"
              }
            ],
            "styles": ["projects/maple/src/styles.scss"],
            "serviceWorker": "ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3MB",
                  "maximumError": "8MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201,
            "proxyConfig": "projects/maple/proxy.conf.json",
            "headers": {
              "Cross-Origin-Opener-Policy": "same-origin",
              "Cross-Origin-Embedder-Policy": "require-corp"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "maple:build:production"
            },
            "development": {
              "buildTarget": "maple:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "tsConfig": ".storybook/tsconfig.json",
            "styles": ["projects/maple/src/styles.scss"],
            "compodoc": false,
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "tsConfig": ".storybook/tsconfig.json",
            "styles": ["projects/maple/src/styles.scss"],
            "compodoc": false,
            "outputDir": "storybook-static"
          }
        }
      }
    },
    "Maple-common": {
      "projectType": "library",
      "root": "projects/maple-common",
      "sourceRoot": "projects/maple-common/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/maple-common/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/maple-common/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/maple-common/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
