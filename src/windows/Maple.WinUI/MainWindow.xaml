<Window
    x:Class="Maple.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Maple.WinUI.ViewModels"
    xmlns:conv="using:Maple.WinUI.Converters"
    xmlns:controls="using:Maple.WinUI.Controls"
    xmlns:mui="using:Maple.UI.Atoms"
    xmlns:muim="using:Maple.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Maple Aperture">

    <Grid Background="{StaticResource MapleBg}" KeyboardAcceleratorPlacementMode="Hidden">

        <Grid.Resources>
            <conv:PickFlagVisibleConverter x:Key="PickVisible" />
            <conv:BoolVisibleConverter x:Key="BoolVisible" />
            <conv:InverseBoolVisibleConverter x:Key="InverseBoolVisible" />
            <CollectionViewSource x:Key="GroupedPhotosSource" IsSourceGrouped="True" />
            <DataTemplate x:Key="SliderRowTemplate" x:DataType="vm:AdjustmentSliderViewModel">
                <StackPanel Margin="0,2,0,6" DoubleTapped="OnSliderRowDoubleTapped">
                    <Grid>
                        <mui:MuiText Text="{Binding Label}" Variant="RowLabel" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource MaplePrimary}"
                                     Visibility="{Binding IsModified, Converter={StaticResource BoolVisible}}"
                                     VerticalAlignment="Center" />
                            <mui:MuiText Text="{Binding FormattedValue}" Variant="ValueChip" />
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                            StepFrequency="{Binding StepFrequency}"
                            Value="{Binding Value, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding Label}"
                            Margin="0,-4,0,0" IsThumbToolTipEnabled="False" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Menu (#2586) — the product's first menu surface; mirrors the
             keyboard table in docs/spec/07-ui-architecture.md. Accelerator text
             is display-only: the keys are handled in OnRootKeyDown. Built from
             Buttons + MenuFlyout (the pattern the folder tree already uses)
             rather than the stock MenuBar, which fails to open its flyouts in
             this shell. ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{StaticResource MapleSidebar}"
                    Padding="6,2" Spacing="2">
            <mui:MuiButton Label="File" Variant="Ghost" ButtonSize="Sm"
                    AutomationProperties.Name="File menu">
                <mui:MuiButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem Text="Open Folder…" Click="OnOpenDirectory"
                                        KeyboardAcceleratorTextOverride="Ctrl+O" />
                        <MenuFlyoutItem Text="Connect to Maple Cloud…" Click="OnConnectCloud" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Export…" Click="OnExportPhotos"
                                        KeyboardAcceleratorTextOverride="Ctrl+E" />
                        <MenuFlyoutSeparator />
                        <!-- Restore from Maple's own trash (#2654) — SMB/network deletes and
                             any local delete where the Recycle Bin call itself failed;
                             local-drive deletes restore from File Explorer's Recycle Bin
                             instead, not here. -->
                        <MenuFlyoutItem Text="Restore from Maple Trash…" Click="OnRestoreFromMapleTrash" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Exit" Click="OnMenuExit" />
                    </MenuFlyout>
                </mui:MuiButton.Flyout>
            </mui:MuiButton>
            <mui:MuiButton Label="Edit" Variant="Ghost" ButtonSize="Sm"
                    AutomationProperties.Name="Edit menu">
                <mui:MuiButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem Text="Undo" Click="OnMenuUndo"
                                        KeyboardAcceleratorTextOverride="Ctrl+Z" />
                        <MenuFlyoutItem Text="Redo" Click="OnMenuRedo"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+Z" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Auto Adjust" Click="OnApplyAuto" />
                        <MenuFlyoutItem Text="Reset All Adjustments" Click="OnResetAll" />
                        <MenuFlyoutItem Text="Revert to Original" Click="OnRevert"
                                        KeyboardAcceleratorTextOverride="Ctrl+R" />
                    </MenuFlyout>
                </mui:MuiButton.Flyout>
            </mui:MuiButton>
            <mui:MuiButton Label="View" Variant="Ghost" ButtonSize="Sm"
                    AutomationProperties.Name="View menu">
                <mui:MuiButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem Text="Browse" Click="OnMenuModeBrowse"
                                        KeyboardAcceleratorTextOverride="Esc" />
                        <MenuFlyoutItem Text="Preview" Click="OnMenuModePreview"
                                        KeyboardAcceleratorTextOverride="Enter" />
                        <MenuFlyoutItem Text="Edit Photo" Click="OnEnterEdit"
                                        KeyboardAcceleratorTextOverride="E" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Zoom to Fit" Click="OnMenuZoomFit"
                                        KeyboardAcceleratorTextOverride="Ctrl+0" />
                        <MenuFlyoutItem Text="Zoom 1:1" Click="OnMenuZoomOneToOne"
                                        KeyboardAcceleratorTextOverride="Ctrl+1" />
                        <MenuFlyoutItem Text="Zoom In" Click="OnMenuZoomIn"
                                        KeyboardAcceleratorTextOverride="Ctrl+=" />
                        <MenuFlyoutItem Text="Zoom Out" Click="OnMenuZoomOut"
                                        KeyboardAcceleratorTextOverride="Ctrl+-" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Toggle Sidebar" Click="OnToggleSidebar" />
                    </MenuFlyout>
                </mui:MuiButton.Flyout>
            </mui:MuiButton>
            <mui:MuiButton Label="Photo" Variant="Ghost" ButtonSize="Sm"
                    AutomationProperties.Name="Photo menu">
                <mui:MuiButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutSubItem Text="Rating">
                            <MenuFlyoutItem Text="None" Click="OnMenuRating" Tag="0"
                                            KeyboardAcceleratorTextOverride="0" />
                            <MenuFlyoutItem Text="★" Click="OnMenuRating" Tag="1"
                                            KeyboardAcceleratorTextOverride="1" />
                            <MenuFlyoutItem Text="★★" Click="OnMenuRating" Tag="2"
                                            KeyboardAcceleratorTextOverride="2" />
                            <MenuFlyoutItem Text="★★★" Click="OnMenuRating" Tag="3"
                                            KeyboardAcceleratorTextOverride="3" />
                            <MenuFlyoutItem Text="★★★★" Click="OnMenuRating" Tag="4"
                                            KeyboardAcceleratorTextOverride="4" />
                            <MenuFlyoutItem Text="★★★★★" Click="OnMenuRating" Tag="5"
                                            KeyboardAcceleratorTextOverride="5" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Pick" Click="OnMenuFlagPick"
                                        KeyboardAcceleratorTextOverride="P" />
                        <MenuFlyoutItem Text="Reject" Click="OnMenuFlagReject"
                                        KeyboardAcceleratorTextOverride="X" />
                        <MenuFlyoutItem Text="Unflag" Click="OnMenuFlagUnflag"
                                        KeyboardAcceleratorTextOverride="U" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Batch Rename…" Click="OnBatchRename" />
                        <!-- Keyboard/Narrator-accessible equivalent to dragging the
                             selection onto a FOLDERS node (#2648) — same code path
                             (RunDragMoveAsync), no drag gesture required. -->
                        <MenuFlyoutItem Text="Move to Folder…" Click="OnMoveToFolder" />
                        <MenuFlyoutSeparator />
                        <!-- Delete → Trash (#2654): local fixed drive uses the Windows
                             Recycle Bin (Explorer owns Restore); SMB/failed-Recycle-Bin
                             falls back to Maple's own .maple/trash, restorable from
                             File → Restore from Maple Trash… -->
                        <MenuFlyoutItem Text="Delete…" Click="OnDeleteSelectedPhotos"
                                        KeyboardAcceleratorTextOverride="Del" />
                        <MenuFlyoutItem Text="Stitch Panorama…" Click="OnStitchPano" />
                    </MenuFlyout>
                </mui:MuiButton.Flyout>
            </mui:MuiButton>
        </StackPanel>

        <!-- ===== Main ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColDef" Width="260" MinWidth="0" MaxWidth="420" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Sources sidebar (Browse only) -->
            <Border x:Name="SidebarPane" Grid.Column="0" Background="{StaticResource MapleSidebar}"
                    BorderBrush="{StaticResource MapleBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="10,12">
                        <StackPanel Spacing="2">
                            <mui:MuiText Text="LIBRARY" Variant="Eyebrow" Margin="8,0,0,6" />
                            <ListView x:Name="LibraryList" SelectionMode="Single" SelectedIndex="0"
                                      SelectionChanged="OnSelectLibraryScope">
                                <ListViewItem Tag="all">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <controls:MapleIconControl IconName="photos" Size="14"
                                                                   IconBrush="{StaticResource MaplePrimary}" />
                                        <TextBlock Text="All Photos" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="pick">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <controls:MapleIconControl IconName="check" Size="14">
                                            <controls:MapleIconControl.IconBrush>
                                                <SolidColorBrush Color="#4CAF50" />
                                            </controls:MapleIconControl.IconBrush>
                                        </controls:MapleIconControl>
                                        <TextBlock Text="Picks" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="reject">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <controls:MapleIconControl IconName="x" Size="14"
                                                                   IconBrush="{StaticResource MapleErrorText}" />
                                        <TextBlock Text="Rejected" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem Tag="rated4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <controls:MapleIconControl IconName="star-filled" Size="14"
                                                                   IconBrush="{StaticResource MapleStar}" />
                                        <TextBlock Text="4+ Stars" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListViewItem>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid Margin="8,0,4,6">
                                <mui:MuiText Text="FOLDERS" Variant="Eyebrow" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Padding="4,2" Background="Transparent"
                                        BorderThickness="0" Click="OnOpenDirectory"
                                        AutomationProperties.Name="Add folder">
                                    <controls:MapleIconControl IconName="plus" Size="12"
                                                               IconBrush="{StaticResource MapleTextMuted}" />
                                </Button>
                            </Grid>
                            <!-- Own capped scroll area: a deep archive must not
                                 swallow the whole sidebar and push the other
                                 sections out of reach. -->
                            <TreeView ItemsSource="{Binding FolderTree}" SelectionMode="None"
                                      ItemInvoked="OnFolderNodeInvoked"
                                      Expanding="OnFolderExpanding"
                                      MaxHeight="440"
                                      AutomationProperties.Name="Folders">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderNode">
                                        <!-- Drag assets onto a folder (#2648): a drop target is
                                             this specific TreeViewItem, not the TreeView as a
                                             whole, so OnFolderDrop always knows exactly which
                                             folder was targeted via DataContext. -->
                                        <TreeViewItem ItemsSource="{Binding Children}"
                                                      ToolTipService.ToolTip="{Binding ToolTipText}"
                                                      AutomationProperties.Name="{Binding DisplayName}"
                                                      AllowDrop="True"
                                                      DragEnter="OnFolderDragEnter"
                                                      DragLeave="OnFolderDragLeave"
                                                      DragOver="OnFolderDragOver"
                                                      Drop="OnFolderDrop">
                                            <TreeViewItem.ContextFlyout>
                                                <!-- New Folder / Rename / Move to Trash (#2647) — fires on
                                                     right-click, touch long-press, AND the keyboard
                                                     context-menu key automatically; no extra input wiring
                                                     needed. Handlers live in MainWindow.FolderContextMenu.cs. -->
                                                <MenuFlyout>
                                                    <!-- MenuFlyoutItem.Icon requires a real IconElement, which
                                                         MuiIcon (a ContentControl) can't satisfy — and this
                                                         MenuFlyout lives inside a per-row DataTemplate, so a
                                                         code-behind x:Name lookup can't reach a single instance
                                                         either to swap in a Mui-built icon. PathIcon (a real
                                                         IconElement) doesn't work as a substitute either: it
                                                         fills its Data geometry, but the shared stroke-icon
                                                         registry's paths (MapleIconShapes.cs) are open,
                                                         zero-area line strokes meant to be drawn, not filled —
                                                         a PathIcon of "M8 7v4M6 9h4" renders invisible. Kept as
                                                         the original native Segoe Fluent Icons FontIcon glyphs. -->
                                                    <MenuFlyoutItem Text="New Folder…" Click="OnNewFolderInTree"
                                                                    AutomationProperties.Name="New folder">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE710;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Rename…" Click="OnRenameFolderInTree"
                                                                    AutomationProperties.Name="Rename folder">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8AC;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Move to Trash" Click="OnTrashFolderInTree"
                                                                    AutomationProperties.Name="Move folder to Trash">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <!-- Show in Explorer (#2658) — every row this tree renders is a
                                                         local or SMB/UNC path (Cloud lives in its own "MAPLE CLOUD"
                                                         ListView below, not this TreeView), so unlike the grid's
                                                         per-selection gating this item is always shown. -->
                                                    <MenuFlyoutItem Text="Show in Explorer" Click="OnRevealFolderInExplorer"
                                                                    AutomationProperties.Name="Show folder in Explorer">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE838;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Remove from Library" Click="OnRemoveFolder"
                                                                    AutomationProperties.Name="Remove folder from library">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE738;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </TreeViewItem.ContextFlyout>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:MapleIconControl IconName="folder" Size="13"
                                                                           IconBrush="{StaticResource MapleTextMuted}" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid Margin="8,0,4,6">
                                <mui:MuiText Text="MAPLE CLOUD" Variant="Eyebrow" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Padding="4,2" Background="Transparent"
                                        BorderThickness="0" Click="OnConnectCloud"
                                        ToolTipService.ToolTip="Connect to a Self-Hosted server"
                                        AutomationProperties.Name="Connect Maple Cloud">
                                    <mui:MuiIcon IconName="cloud" Size="Xs14" IconColor="{StaticResource MapleTextMuted}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding CloudStatus}" FontSize="10" Margin="8,0,4,4"
                                       TextWrapping="Wrap" Foreground="{StaticResource MapleTextMuted}" />
                            <Button HorizontalAlignment="Stretch" Margin="4,2,4,4" Padding="8,6"
                                    Click="OnConnectCloud"
                                    Visibility="{Binding CloudConnected, Converter={StaticResource InverseBoolVisible}}"
                                    AutomationProperties.Name="Connect to Maple Cloud server">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mui:MuiIcon IconName="cloud" Size="Xs14" IconColor="{StaticResource MaplePrimary}" />
                                    <TextBlock Text="Connect to server…" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <ListView x:Name="CloudFoldersList" ItemsSource="{Binding CloudFolders}"
                                      SelectionMode="Single" SelectionChanged="OnSelectCloudFolder">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <mui:MuiIcon IconName="cloud" Size="Xs14" IconColor="{StaticResource MaplePrimary}" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding FileCount}" FontSize="11"
                                                       Foreground="{StaticResource MapleTextMuted}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid Margin="8,0,4,6">
                                <mui:MuiText Text="TIMELINE" Variant="Eyebrow" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Padding="4,2" Background="Transparent"
                                        BorderThickness="0" Click="OnClearTimelineFilter"
                                        ToolTipService.ToolTip="Show all dates"
                                        AutomationProperties.Name="Clear timeline filter">
                                    <controls:MapleIconControl IconName="x" Size="11"
                                                               IconBrush="{StaticResource MapleTextMuted}" />
                                </Button>
                            </Grid>
                            <TreeView ItemsSource="{Binding Timeline.Nodes}" SelectionMode="None"
                                      ItemInvoked="OnTimelineNodeInvoked"
                                      MaxHeight="360"
                                      AutomationProperties.Name="Timeline">
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TimelineNode">
                                        <TreeViewItem ItemsSource="{Binding Children}" IsExpanded="True"
                                                      AutomationProperties.Name="{Binding Label}">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <mui:MuiIcon IconName="calendar" Size="Xs14" IconColor="{StaticResource MapleTextMuted}" />
                                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PhotoCount}" FontSize="11" Margin="12,0,0,0"
                                                           Foreground="{StaticResource MapleTextMuted}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </TreeViewItem>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center -->
            <Grid Grid.Column="1">

                <!-- BROWSE -->
                <Grid x:Name="BrowseGridContainer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource MapleBorder}" BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mui:MuiButton IconName="sidebar" Variant="Secondary" ButtonSize="Sm"
                                        Click="OnToggleSidebar"
                                        AutomationProperties.Name="Toggle sources panel" />
                                <ComboBox x:Name="FormatFilterBox" SelectedIndex="0" Width="120" FontSize="12"
                                          SelectionChanged="OnFormatFilterChanged"
                                          AutomationProperties.Name="Format filter">
                                    <ComboBoxItem Content="All Formats" Tag="All" />
                                    <ComboBoxItem Content="DNG" Tag="DNG" />
                                    <ComboBoxItem Content="CR2" Tag="CR2" />
                                    <ComboBoxItem Content="CR3" Tag="CR3" />
                                    <ComboBoxItem Content="ARW" Tag="ARW" />
                                    <ComboBoxItem Content="NEF" Tag="NEF" />
                                </ComboBox>
                                <ComboBox x:Name="RatingFilterBox" SelectedIndex="0" Width="120" FontSize="12"
                                          SelectionChanged="OnRatingFilterChanged"
                                          AutomationProperties.Name="Rating filter">
                                    <ComboBoxItem Content="All Ratings" Tag="0" />
                                    <ComboBoxItem Content="★ 3+" Tag="3" />
                                    <ComboBoxItem Content="★ 4+" Tag="4" />
                                    <ComboBoxItem Content="★ 5" Tag="5" />
                                </ComboBox>
                                <TextBlock x:Name="LibraryCountText" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource MapleTextMuted}" Margin="8,0,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                                <!-- Narrator-only: announces inline-rename commit/cancel outcomes
                                     (#2639) and batch-rename apply outcomes (#2642, via the same
                                     AnnounceRename helper). Zero visual footprint — content, not chrome. -->
                                <TextBlock x:Name="RenameStatusText" Width="0" Height="0" Opacity="0"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox" Width="200" PlaceholderText="Search name, camera, lens…"
                                         Background="{StaticResource MapleInputBg}" FontSize="12"
                                         TextChanged="OnSearchChanged" AutomationProperties.Name="Search library" />
                                <mui:MuiButton IconName="export" Label="Export" Variant="Secondary" ButtonSize="Sm"
                                        Click="OnExportPhotos"
                                        ToolTipService.ToolTip="Export JPEG (Ctrl+Shift+E)"
                                        AutomationProperties.Name="Export photo" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <GridView x:Name="PhotoGrid" Grid.Row="1"
                              ItemsSource="{Binding Source={StaticResource GroupedPhotosSource}}"
                              SelectionMode="Extended" Padding="12"
                              SelectionChanged="OnPhotoGridSelectionChanged"
                              DoubleTapped="OnGridDoubleTapped"
                              CanDragItems="True"
                              DragItemsStarting="OnPhotoGridDragItemsStarting"
                              DragItemsCompleted="OnPhotoGridDragItemsCompleted"
                              AutomationProperties.Name="Photo grid">
                        <!-- Right-click Delete on the grid selection (#2654) — same
                             OnDeleteSelectedPhotos handler as the Delete key and the
                             Photo menu's "Delete…" item, so none of the three can
                             drift from another. "Show in Explorer" (#2658) is HIDDEN
                             (not disabled) when nothing in the selection has a local
                             path — OnPhotoGridContextFlyoutOpening toggles both the
                             item and its separator on every open. -->
                        <GridView.ContextFlyout>
                            <MenuFlyout Opening="OnPhotoGridContextFlyoutOpening">
                                <!-- MenuFlyoutItem.Icon requires a real IconElement (MuiIcon and
                                     PathIcon-of-the-stroke-registry both fail here — see the
                                     folder-tree context menu's matching comment above). Kept as
                                     the original native FontIcon glyph. -->
                                <MenuFlyoutItem x:Name="RevealInExplorerMenuItem" Text="Show in Explorer"
                                                Click="OnRevealSelectedPhotosInExplorer"
                                                AutomationProperties.Name="Show in Explorer">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator x:Name="RevealInExplorerSeparator" />
                                <MenuFlyoutItem Text="Delete…" Click="OnDeleteSelectedPhotos"
                                                AutomationProperties.Name="Delete selected photos" />
                            </MenuFlyout>
                        </GridView.ContextFlyout>
                        <GridView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="vm:PhotoDayGroup">
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,4">
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MapleTextMain}" />
                                            <TextBlock Text="{Binding Count}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MapleTextMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </GridView.GroupStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="180" Height="180" Margin="2" CornerRadius="4"
                                      AutomationProperties.Name="{Binding FileName}"
                                      Background="{StaticResource MapleSurface}">
                                    <controls:MapleIconControl IconName="photos" Size="36"
                                                               IconBrush="{StaticResource MapleBorder}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                            Padding="5,1" CornerRadius="3" Background="#CC141210">
                                        <TextBlock Text="{Binding Format}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource MapleTextMuted}" />
                                    </Border>
                                    <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="6"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Visibility="{Binding FlagStatus, Converter={StaticResource PickVisible}}" />
                                    <Border VerticalAlignment="Bottom" Background="#B3141210" Padding="6,3">
                                        <Grid>
                                            <!-- Inline rename (#2639): F2 or double-click swaps this
                                                 TextBlock for the TextBox below. Same PhotoItem, so both
                                                 surfaces stay in sync via IsRenaming/RenameText. -->
                                            <TextBlock Text="{Binding FileName}" FontSize="10"
                                                       Foreground="{StaticResource MapleTextMain}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,48,0"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolVisible}}"
                                                       DoubleTapped="OnFileNameDoubleTapped" />
                                            <TextBox Text="{Binding RenameText, Mode=TwoWay}" FontSize="10"
                                                      Padding="2,0" Margin="0,0,48,0"
                                                      Visibility="{Binding IsRenaming, Converter={StaticResource BoolVisible}}"
                                                      AutomationProperties.Name="Rename file"
                                                      KeyDown="OnRenameTextBoxKeyDown"
                                                      LostFocus="OnRenameTextBoxLostFocus"
                                                      DoubleTapped="OnRenameTextBoxDoubleTapped" />
                                            <TextBlock Text="{Binding RatingStars}" FontSize="9"
                                                       Foreground="{StaticResource MapleStar}"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolVisible}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock x:Name="EmptyStateText" Grid.Row="1" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="13" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               Foreground="{StaticResource MapleTextMuted}"
                               Text="No photos directly in this folder — its photos live in subfolders. Pick a subfolder from the FOLDERS tree." />
                </Grid>

                <!-- PREVIEW + EDIT share the canvas -->
                <Grid x:Name="ViewerContainer" Visibility="Collapsed" Background="{StaticResource MapleImageCanvas}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" x:Name="CanvasHost" SizeChanged="OnCanvasHostSizeChanged">
                        <!-- Zoom/pan viewer (#2572): ScrollViewer zoom over both
                             display paths — fit at factor 1, Ctrl+wheel / pinch /
                             double-click toggle / Ctrl+0/1/=/- ; drag pans when
                             zoomed. Zoom resets on navigation per the spec. -->
                        <ScrollViewer x:Name="ViewerScroll" Margin="16,64,16,16"
                                      ZoomMode="Enabled" MinZoomFactor="0.4" MaxZoomFactor="8"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                      DoubleTapped="OnViewerDoubleTapped">
                            <Grid x:Name="ZoomHost">
                                <!-- Crop display host (#2582): rotation applies here,
                                     the clip + fit-scale transform applies via code
                                     (rotate-then-crop, matching the renderer). -->
                                <Grid x:Name="CropRotateHost" RenderTransformOrigin="0.5,0.5">
                                    <Image x:Name="ViewportImage" Stretch="Uniform"
                                           AutomationProperties.Name="Rendered preview canvas" />
                                    <!-- DX12 present target (#2561): the wgpu live chain
                                         draws straight into this panel's composition
                                         swapchain; sized from code to the session dims. -->
                                    <SwapChainPanel x:Name="ViewportSwapChainPanel" Visibility="Collapsed"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    AutomationProperties.Name="GPU preview canvas" />
                                    <!-- Clipping overlay (#2574): transparent except
                                         red (blown highlights) / blue (crushed shadows);
                                         zooms and pans with the frame. -->
                                    <Image x:Name="ClipOverlayImage" Stretch="Uniform" Visibility="Collapsed"
                                           IsHitTestVisible="False"
                                           AutomationProperties.Name="Clipping overlay" />
                                </Grid>
                                <controls:CropOverlayControl x:Name="CropOverlay" Visibility="Collapsed"
                                                             AutomationProperties.Name="Crop overlay" />
                            </Grid>
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsDecoding, Converter={StaticResource BoolVisible}}">
                            <ProgressRing IsActive="{Binding IsDecoding}" Width="20" Height="20" />
                            <TextBlock Text="{Binding DecodeStatus}" FontSize="12"
                                       Foreground="{StaticResource MapleTextMuted}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Preview top pill -->
                        <Border x:Name="PreviewTopBar"
                                Background="#F21C1917" BorderBrush="{StaticResource MapleBorder}"
                                BorderThickness="1" CornerRadius="10"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <mui:MuiButton IconName="back" Variant="Ghost" ButtonSize="Sm" Click="OnViewerBack"
                                        ToolTipService.ToolTip="Back to Browse (Esc)"
                                        AutomationProperties.Name="Back to browse" />
                                <TextBlock Text="{Binding SelectedPhoto.FileName}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{StaticResource MapleTextMain}" />
                                <TextBlock Text="{Binding SelectedPhoto.Dimensions}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{StaticResource MapleTextMuted}" />
                                <StackPanel x:Name="StarRow" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" />
                                <mui:MuiButton x:Name="PickBtn" IconName="check" Variant="Ghost" ButtonSize="Sm"
                                        IconColor="#4CAF50" Click="OnFlagPick"
                                        ToolTipService.ToolTip="Pick (P)" AutomationProperties.Name="Flag as pick" />
                                <mui:MuiButton x:Name="RejectBtn" IconName="x" Variant="Ghost" ButtonSize="Sm"
                                        IconColor="{StaticResource MapleErrorText}" Click="OnFlagReject"
                                        ToolTipService.ToolTip="Reject (X)" AutomationProperties.Name="Flag as reject" />
                                <mui:MuiButton IconName="info" Variant="Ghost" ButtonSize="Sm"
                                        ToolTipService.ToolTip="Info &amp; EXIF" AutomationProperties.Name="Photo info">
                                    <mui:MuiButton.Flyout>
                                        <Flyout Opening="OnInfoFlyoutOpening">
                                            <StackPanel Width="260" Spacing="10">
                                                <mui:MuiText Text="CAMERA" Variant="Eyebrow" />
                                                <StackPanel x:Name="ExifRows" Spacing="6" />
                                                <mui:MuiText Text="FILE" Variant="Eyebrow" Margin="0,6,0,0" />
                                                <StackPanel x:Name="FileRows" Spacing="6" />
                                            </StackPanel>
                                        </Flyout>
                                    </mui:MuiButton.Flyout>
                                </mui:MuiButton>
                                <Button Style="{StaticResource AccentButtonStyle}" Padding="14,5" Click="OnEnterEdit"
                                        AutomationProperties.Name="Edit photo">
                                    <TextBlock Text="Edit" FontSize="12" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Edit top pill -->
                        <Border x:Name="EditTopBar" Visibility="Collapsed"
                                Background="#F21C1917" BorderBrush="{StaticResource MapleBorder}"
                                BorderThickness="1" CornerRadius="10"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <mui:MuiButton IconName="back" Variant="Ghost" ButtonSize="Sm" Click="OnExitEdit"
                                        ToolTipService.ToolTip="Back to Preview (Esc)"
                                        AutomationProperties.Name="Back to preview" />
                                <TextBlock Text="{Binding SelectedPhoto.FileName}" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{StaticResource MapleTextMain}" />
                                <Border Width="96" Height="30" CornerRadius="4" Background="{StaticResource MapleImageCanvas}"
                                        BorderBrush="{StaticResource MapleBorder}" BorderThickness="1">
                                    <Grid>
                                        <Canvas x:Name="HistogramCanvas" Margin="2" />
                                        <!-- Clipping indicators (#2574): lit when channels clip;
                                             click toggles the canvas clipping overlay. -->
                                        <Button x:Name="ShadowClipButton" Width="12" Height="12" Padding="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1"
                                                Background="Transparent" BorderThickness="0"
                                                Click="OnToggleShadowClip"
                                                ToolTipService.ToolTip="Show shadow clipping (J)"
                                                AutomationProperties.Name="Shadow clipping indicator">
                                            <Ellipse x:Name="ShadowClipDot" Width="6" Height="6"
                                                     Fill="{StaticResource MapleBorderHi}" />
                                        </Button>
                                        <Button x:Name="HighlightClipButton" Width="12" Height="12" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="1"
                                                Background="Transparent" BorderThickness="0"
                                                Click="OnToggleHighlightClip"
                                                ToolTipService.ToolTip="Show highlight clipping (J)"
                                                AutomationProperties.Name="Highlight clipping indicator">
                                            <Ellipse x:Name="HighlightClipDot" Width="6" Height="6"
                                                     Fill="{StaticResource MapleBorderHi}" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <mui:MuiButton Label="AUTO" Variant="Ghost" ButtonSize="Sm" Click="OnApplyAuto"
                                        AutomationProperties.Name="Auto adjust" />
                                <mui:MuiButton Label="RESET" Variant="Ghost" ButtonSize="Sm" Click="OnResetAll"
                                        ToolTipService.ToolTip="Reset all adjustments"
                                        AutomationProperties.Name="Reset adjustments" />
                                <mui:MuiButton IconName="revert" Variant="Ghost" ButtonSize="Sm" Click="OnRevert"
                                        ToolTipService.ToolTip="Revert to sidecar state at open (Ctrl+R)"
                                        AutomationProperties.Name="Revert edits" />
                                <TextBlock x:Name="RenderStatsText" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{StaticResource MapleTextMuted}" />
                                <mui:MuiButton IconName="export" Variant="Ghost" ButtonSize="Sm"
                                        IconColor="{StaticResource MaplePrimary}" Click="OnExportPhotos"
                                        ToolTipService.ToolTip="Export JPEG (Ctrl+Shift+E)"
                                        AutomationProperties.Name="Export photo" />
                            </StackPanel>
                        </Border>

                        <!-- Edit tool rail -->
                        <Border x:Name="EditRail" Visibility="Collapsed"
                                Background="#F21C1917" BorderBrush="{StaticResource MapleBorder}"
                                BorderThickness="1" CornerRadius="10"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                Padding="6,10">
                            <StackPanel x:Name="EditRailStack" Spacing="4" />
                        </Border>

                        <!-- Floating group panel -->
                        <Border x:Name="EditPanel" Visibility="Collapsed"
                                Background="#F21C1917" BorderBrush="{StaticResource MapleBorder}"
                                BorderThickness="1" CornerRadius="10"
                                Width="300" MaxHeight="620"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,86,0"
                                Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock x:Name="EditPanelTitle" FontSize="11" FontWeight="Bold"
                                               CharacterSpacing="120" Foreground="{StaticResource MaplePrimary}" />
                                    <mui:MuiButton IconName="revert" Variant="Ghost" ButtonSize="Sm"
                                            IconColor="{StaticResource MapleTextMuted}"
                                            HorizontalAlignment="Right"
                                            Click="OnResetGroup" ToolTipService.ToolTip="Reset this group"
                                            AutomationProperties.Name="Reset group" />
                                </Grid>
                                <StackPanel x:Name="ColorTabRow" Grid.Row="1" Orientation="Horizontal" Spacing="4"
                                            Margin="0,0,0,6" Visibility="Collapsed">
                                    <mui:MuiActionButton x:Name="ColorTabBasic" Label="Basic" ButtonSize="Sm"
                                            Click="OnColorTab" AutomationProperties.Name="Color basic tab" />
                                    <mui:MuiActionButton x:Name="ColorTabHsl" Label="HSL" ButtonSize="Sm"
                                            Click="OnColorTab" AutomationProperties.Name="Color HSL tab" />
                                    <mui:MuiActionButton x:Name="ColorTabBw" Label="B&amp;W" ButtonSize="Sm"
                                            Click="OnColorTab" AutomationProperties.Name="Color B&amp;W tab" />
                                </StackPanel>
                                <StackPanel x:Name="EffectsTabRow" Grid.Row="1" Orientation="Horizontal" Spacing="4"
                                            Margin="0,0,0,6" Visibility="Collapsed">
                                    <mui:MuiActionButton x:Name="EffectsTabBasic" Label="Basic" ButtonSize="Sm"
                                            Click="OnEffectsTab" AutomationProperties.Name="Effects basic tab" />
                                    <mui:MuiActionButton x:Name="EffectsTabGrade" Label="Grade" ButtonSize="Sm"
                                            Click="OnEffectsTab" AutomationProperties.Name="Effects grade tab" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Point tone-curve plot (#2576): channel tabs, plot,
                                             reset footer — above the parametric sliders. -->
                                        <StackPanel x:Name="PanelCurveHost" Visibility="Collapsed" Spacing="6"
                                                    Margin="0,0,0,8">
                                            <StackPanel x:Name="CurveChannelRow" Orientation="Horizontal" Spacing="4">
                                                <mui:MuiActionButton x:Name="CurveTabLuma" Label="Luma" ButtonSize="Sm"
                                                        Click="OnCurveChannel" AutomationProperties.Name="Curve luma channel" />
                                                <mui:MuiActionButton x:Name="CurveTabRed" Label="R" ButtonSize="Sm"
                                                        Click="OnCurveChannel" AutomationProperties.Name="Curve red channel" />
                                                <mui:MuiActionButton x:Name="CurveTabGreen" Label="G" ButtonSize="Sm"
                                                        Click="OnCurveChannel" AutomationProperties.Name="Curve green channel" />
                                                <mui:MuiActionButton x:Name="CurveTabBlue" Label="B" ButtonSize="Sm"
                                                        Click="OnCurveChannel" AutomationProperties.Name="Curve blue channel" />
                                            </StackPanel>
                                            <muim:MuiCurvePlot x:Name="CurvePlot" PlotWidth="272" PlotHeight="270"
                                                               PointEditing="True" Smoothing="MonotoneCubic" ShowGrid="True"
                                                               AutomationProperties.Name="Tone curve plot" />
                                            <Grid>
                                                <TextBlock Text="Shadows" FontSize="9"
                                                           Foreground="{StaticResource MapleTextMuted}"
                                                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <mui:MuiButton x:Name="CurveResetButton" Label="Reset curve" Variant="Ghost" ButtonSize="Sm"
                                                        HorizontalAlignment="Center"
                                                        Click="OnCurveReset"
                                                        AutomationProperties.Name="Reset curve" />
                                                <TextBlock Text="Highlights" FontSize="9"
                                                           Foreground="{StaticResource MapleTextMuted}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                        <ItemsControl x:Name="PanelSliders"
                                                      ItemTemplate="{StaticResource SliderRowTemplate}" />
                                        <StackPanel x:Name="PanelBwHeader" Visibility="Collapsed" Margin="0,0,0,6">
                                            <ToggleSwitch OnContent="Black &amp; White" OffContent="Color" FontSize="11"
                                                          IsOn="{Binding BlackWhiteOn, Mode=TwoWay}"
                                                          AutomationProperties.Name="Black and white toggle" />
                                        </StackPanel>
                                        <ItemsControl x:Name="PanelHslBands" Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HslBandViewModel">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Band}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource MapleTextMuted}" Margin="0,4,0,2" />
                                                        <ContentControl Content="{Binding Hue}"
                                                                        ContentTemplate="{StaticResource SliderRowTemplate}"
                                                                        HorizontalContentAlignment="Stretch" />
                                                        <ContentControl Content="{Binding Sat}"
                                                                        ContentTemplate="{StaticResource SliderRowTemplate}"
                                                                        HorizontalContentAlignment="Stretch" />
                                                        <ContentControl Content="{Binding Lum}"
                                                                        ContentTemplate="{StaticResource SliderRowTemplate}"
                                                                        HorizontalContentAlignment="Stretch" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Color grading wheels (#2578): 2x2 zone grid, lum slider
                                             per cell, balance below — the web panel's layout. -->
                                        <StackPanel x:Name="PanelGradeHost" Visibility="Collapsed">
                                            <Grid ColumnSpacing="12" RowSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" x:Name="GradeCellShadows" Spacing="3" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" x:Name="GradeCellMidtones" Spacing="3" />
                                                <StackPanel Grid.Row="1" Grid.Column="0" x:Name="GradeCellHighlights" Spacing="3" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" x:Name="GradeCellGlobal" Spacing="3" />
                                            </Grid>
                                            <ContentControl x:Name="GradeBalanceHost" Margin="0,8,0,0"
                                                            ContentTemplate="{StaticResource SliderRowTemplate}"
                                                            HorizontalContentAlignment="Stretch" />
                                        </StackPanel>
                                        <!-- Crop toolbar (#2582): aspect presets, straighten,
                                             reset/done — the overlay lives on the canvas. -->
                                        <StackPanel x:Name="PanelCropHost" Visibility="Collapsed" Spacing="10">
                                            <ComboBox x:Name="CropAspectCombo" Header="Aspect"
                                                      HorizontalAlignment="Stretch"
                                                      SelectionChanged="OnCropAspectChanged" />
                                            <StackPanel>
                                                <Grid>
                                                    <mui:MuiText Text="Straighten" Variant="RowLabel" />
                                                    <mui:MuiText x:Name="CropAngleText" Text="0.0°"
                                                               Variant="ValueChip"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <Slider x:Name="CropAngleSlider" Minimum="-45" Maximum="45"
                                                        StepFrequency="0.1" Value="0" Margin="0,-4,0,0"
                                                        IsThumbToolTipEnabled="False"
                                                        ValueChanged="OnCropAngleChanged"
                                                        AutomationProperties.Name="Straighten angle" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mui:MuiButton Label="Reset" Variant="Ghost" ButtonSize="Sm"
                                                        Click="OnCropReset"
                                                        AutomationProperties.Name="Reset crop" />
                                                <mui:MuiButton Label="Done" Variant="Ghost" ButtonSize="Sm"
                                                        Click="OnCropDone"
                                                        AutomationProperties.Name="Crop done" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="PanelFootnote" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource MapleTextMuted}" Visibility="Collapsed" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Filmstrip (Preview only) -->
                    <Border x:Name="FilmstripBar" Grid.Row="1" Height="80" Background="{StaticResource MapleBg}"
                            BorderBrush="{StaticResource MapleBorder}" BorderThickness="0,1,0,0" Padding="6,4">
                        <ListView x:Name="Filmstrip" ItemsSource="{Binding Photos}"
                                  SelectionMode="Single" SelectionChanged="OnGridSelectionChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  AutomationProperties.Name="Filmstrip">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="86" Height="60" Margin="2" CornerRadius="3"
                                          AutomationProperties.Name="{Binding FileName}"
                                          Background="{StaticResource MapleSurface}">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        <Ellipse Width="6" Height="6" Fill="#4CAF50" Margin="4"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Visibility="{Binding FlagStatus, Converter={StaticResource PickVisible}}" />
                                        <Border Background="#B3141210" VerticalAlignment="Bottom" Padding="3,1">
                                            <TextBlock Text="{Binding RatingStars}" FontSize="8"
                                                       Foreground="{StaticResource MapleStar}" HorizontalAlignment="Left" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
