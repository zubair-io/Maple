<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle identity — spec § 00: app.justmaple.Maple-Maple -->
    <key>CFBundleIdentifier</key>
    <string>app.justmaple.Maple-Maple</string>

    <key>CFBundleName</key>
    <string>Maple</string>

    <key>CFBundleDisplayName</key>
    <string>Maple</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleExecutable</key>
    <string>MapleApp</string>

    <!-- High-res display -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Dark-mode preferred -->
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>

    <!-- Photo Library access (iOS/macOS) -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Maple accesses your photo library to open and edit RAW photos.</string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Maple can save edited photos back to your library.</string>

    <!-- Bonjour / SMB discovery -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Maple connects to SMB servers on your local network to access RAW files.</string>

    <key>NSBonjourServices</key>
    <array>
        <string>_smb._tcp</string>
    </array>

    <!-- Security-scoped bookmarks (macOS) -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- Metal GPU family -->
    <key>MetalCaptureEnabled</key>
    <false/>

    <!-- Camera (not required now but reserved for future direct capture) -->
    <!-- <key>NSCameraUsageDescription</key> -->
    <!-- <string>Maple can capture RAW photos directly from the camera.</string> -->

    <!-- iOS UI configuration -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIRequiresFullScreen</key>
    <false/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- App category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.photography</string>

    <!-- Minimum OS -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <key>MinimumOSVersion</key>
    <string>17.0</string>
</dict>
</plist>
