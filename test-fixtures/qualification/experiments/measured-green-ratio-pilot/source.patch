+#[test]
+fn measured_green_ratio_requires_unclipped_sensor_evidence() {
+    for pattern in PATTERNS {
+        for target in [0, 2] {
+            for exposure in [0.01_f32, 1.0, 16.0] {
+                let centre = (10..14)
+                    .flat_map(|y| (10..14).map(move |x| y * SIDE + x))
+                    .find(|&i| sampled(pattern, i) == 1)
+                    .unwrap();
+                let mut cfa = vec![0.1 * exposure; SIDE * SIDE];
+                let mut green = vec![0.1 * exposure; SIDE * SIDE];
+                cfa[centre] = 0.5 * exposure;
+                green[centre] = cfa[centre];
+                let donors: Vec<_> = [-1_isize, 1, -(SIDE as isize), SIDE as isize]
+                    .into_iter()
+                    .map(|d| (centre as isize + d) as usize)
+                    .filter(|&i| sampled(pattern, i) == target)
+                    .collect();
+                for (i, (value, g)) in donors.into_iter().zip([(0.42, 0.4), (0.8, 0.8)]) {
+                    cfa[i] = value * exposure;
+                    green[i] = g * exposure;
+                }
+                let run = |limits: [f32; 3]| {
+                    let mut image =
+                        Image::new(SIDE as u32, SIDE as u32, ColorSpace::CameraNativeLinearRgb);
+                    image.pixels.fill([0.2 * exposure; 3]);
+                    image.pixels[centre][1] = 0.5 * exposure;
+                    fcs::suppress_false_colour(
+                        &mut image,
+                        &cfa,
+                        &green,
+                        SIDE,
+                        SIDE,
+                        pattern,
+                        fcs::FALSE_COLOUR_SUPPRESS_STRENGTH,
+                        limits,
+                    );
+                    assert_eq!(image.pixels[centre][1], 0.5 * exposure);
+                    image.pixels[centre][target]
+                };
+                let initial = 0.2 * exposure;
+                let value = 0.61 * exposure;
+                let ghf = (0.5 * exposure - 0.35 * exposure).abs()
+                    / (0.5 * exposure + 0.35 * exposure + 1e-6);
+                let disagree = (value - initial).abs() / (value + initial + 1e-6);
+                let alpha = (fcs::FALSE_COLOUR_SUPPRESS_STRENGTH * ghf * disagree).clamp(0.0, 1.0);
+                let expected = (1.0 - alpha) * initial + alpha * value;
+                let mut donor_clipped = [exposure; 3];
+                donor_clipped[target] = 0.8 * exposure;
+                let mut anchor_clipped = [exposure; 3];
+                anchor_clipped[1] = 0.5 * exposure;
+                for limits in [donor_clipped, anchor_clipped] {
+                    assert!((run(limits) - expected).abs() <= 1e-6 * exposure);
+                }
+                assert!(run([exposure; 3]) < expected - 0.001 * exposure);
+            }
+        }
+    }
+}
