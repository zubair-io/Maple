{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "raw-wasm",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/raw_wasm_bg.wasm", "/pkg/**"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/fonts/**", "/*.(otf|ttf|woff|woff2)"]
      }
    },
    {
      "name": "images",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/assets/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|ico)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "thumbnails",
      "urls": ["/api/fs/thumb", "/api/assets/*/thumb"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 1500,
        "maxAge": "30d"
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"]
}
