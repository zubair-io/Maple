+#[test]
+fn common_highlight_blend_curvature_joins_both_constant_endpoints() {
+    let hi = 256.0f32;
+    let high_out = hi.sqrt();
+    let shoulder_log = AGX_MAX_EV + AGX_MID_GRAY.log2();
+    let weight = |position: f32| {
+        let lo = (position * shoulder_log).exp2();
+        let ratio_low = lo * high_out / hi;
+        let curve_low = lo.sqrt();
+        let low_out = common_highlight_minimum(lo, hi, high_out, curve_low);
+        f64::from((low_out - ratio_low) / (curve_low - ratio_low))
+    };
+    let curvature = |position: f32, step: f32| {
+        (weight(position + step) - 2.0 * weight(position) + weight(position - step))
+            / f64::from(step * step)
+    };
+    for boundary in [0.0f32, 1.0] {
+        let coarse = curvature(boundary, 0.125).abs();
+        let fine = curvature(boundary, 0.0625).abs();
+        assert!(
+            fine < coarse * 0.75,
+            "boundary={boundary}, coarse curvature={coarse}, fine curvature={fine}"
+        );
+    }
+}
