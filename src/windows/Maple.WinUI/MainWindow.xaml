<Window
    x:Class="Maple.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Maple — Professional RAW Photo Editor">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <!-- Column 0: Sources Tree -->
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="Auto" />
            <!-- Column 1: Viewport / Grid -->
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="Auto" />
            <!-- Column 2: Detail Inspector Panel -->
            <ColumnDefinition Width="320" MinWidth="280" MaxWidth="450" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: Sources Tree Panel -->
        <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="SOURCES" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                <TreeView Grid.Row="1" x:Name="SourcesTreeView">
                    <TreeView.RootNodes>
                        <TreeViewNode Content="Local Pictures" />
                        <TreeViewNode Content="External Drives" />
                        <TreeViewNode Content="Network Shares (SMB)" />
                    </TreeView.RootNodes>
                </TreeView>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext" />

        <!-- Column 1: Image Viewport (SwapChainPanel) -->
        <Grid Grid.Column="2" Background="#111111">
            <SwapChainPanel x:Name="ViewportSwapChainPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <TextBlock Text="Scene-Linear Rec.2020 D65 f32 Viewport (DirectX 12 / wgpu)" 
                       Foreground="#888888" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Bottom" 
                       Margin="0,0,0,16" />
        </Grid>

        <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext" />

        <!-- Column 2: Detail Inspector Panel -->
        <ScrollViewer Grid.Column="4" Padding="16">
            <StackPanel Spacing="16">
                <TextBlock Text="INSPECTOR" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                
                <!-- Tone Controls -->
                <Expander Header="Tone Controls" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Exposure" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="ExposureSlider" Minimum="-5.0" Maximum="5.0" StepFrequency="0.05" Value="0.0" ValueChanged="OnAdjustmentChanged" />
                        
                        <TextBlock Text="Contrast" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />

                        <TextBlock Text="Highlights" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="HighlightsSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />

                        <TextBlock Text="Shadows" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="ShadowsSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />
                    </StackPanel>
                </Expander>

                <!-- Color Controls -->
                <Expander Header="Color &amp; WB" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Temperature" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="TempSlider" Minimum="2000" Maximum="12000" Value="5500" ValueChanged="OnAdjustmentChanged" />

                        <TextBlock Text="Vibrance" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="VibranceSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />
                    </StackPanel>
                </Expander>

                <!-- Detail Controls -->
                <Expander Header="Detail &amp; Dehaze" IsExpanded="True" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="Texture" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="TextureSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />

                        <TextBlock Text="Dehaze" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Slider x:Name="DehazeSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
