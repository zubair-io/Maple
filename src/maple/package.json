{
  "name": "@justmaple/maple",
  "version": "0.0.5",
  "description": "Maple image development engine and CLI by Just Maple",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "bin": {
    "maple": "bin/maple.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zubair-io/Maple.git",
    "directory": "src/maple"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && tsc -p tsconfig.json",
    "test": "bun test",
    "bench": "bun ../api/scripts/bench-maple-vs-sharp.ts",
    "sync:versions": "bun ./scripts/sync-versions.ts",
    "assemble": "bun ./scripts/assemble-packages.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "@justmaple/maple-darwin-arm64": "0.0.5",
    "@justmaple/maple-darwin-x64": "0.0.5",
    "@justmaple/maple-linux-arm64-gnu": "0.0.5",
    "@justmaple/maple-linux-arm64-musl": "0.0.5",
    "@justmaple/maple-linux-x64-gnu": "0.0.5",
    "@justmaple/maple-linux-x64-musl": "0.0.5",
    "@justmaple/maple-win32-x64-msvc": "0.0.5"
  }
}
