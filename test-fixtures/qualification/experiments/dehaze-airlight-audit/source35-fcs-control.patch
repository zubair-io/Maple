+            "threshold":threshold,"strictly_above":above.len(),"tied":tied.len(),
+            "selected_from_tie":top_n-above.len(),"tie_weight":tie_weight,
+            "current_A":[sum[0]/k,sum[1]/k,sum[2]/k],
+            "fractional_tie_A":[weighted[0]/k as f64,weighted[1]/k as f64,weighted[2]/k as f64],
+            "tie_min":tie_min,"tie_max":tie_max
