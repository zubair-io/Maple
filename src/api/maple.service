# Maple Self Hosted — systemd unit file
#
# Copy to: /etc/systemd/system/maple.service
#
# After installing:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maple
#   sudo systemctl status maple
#   journalctl -fu maple

[Unit]
Description=Maple Self Hosted Server
Documentation=https://github.com/zubair.io/maple
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maple
Group=maple

# --- Edit these paths ---
WorkingDirectory=/opt/maple
ExecStart=/usr/local/bin/bun src/index.ts

# Environment
Environment=PORT=3000
# The library database — one SQLite file holding every folder, asset row and
# setting. It must sit on a path this unit can write to and that survives a
# restart: WorkingDirectory (/opt/maple) is read-only under ProtectSystem=strict,
# so the code default (./data/maple.sqlite) cannot be created there. /var/lib/maple
# is in ReadWritePaths below. The server creates the file and the directory
# above it on first boot. Back this path up — losing it means a full re-index.
Environment=MAPLE_SQLITE_PATH=/var/lib/maple/maple.sqlite
# The fallback JWT secret file, used only on a boot where the database above
# cannot be opened. Same reasoning as the database path: WorkingDirectory
# (/opt/maple) is read-only under ProtectSystem=strict, so the code default
# (./.maple/jwt.secret) can't be written. /var/lib/maple is in ReadWritePaths
# below and survives restarts — keeping the secret stable so issued access
# tokens don't fail with "bad signature".
Environment=MAPLE_JWT_SECRET_FILE=/var/lib/maple/jwt.secret
# Uncomment and set your photo library roots:
# Environment=MAPLE_ROOTS=/srv/photos

# WebAuthn / passkey auth — REQUIRED in production. The browser refuses
# passkey ceremonies whose rpId/origin don't match the page hostname.
# Environment=MAPLE_RP_ID=maple.your-domain.com
# Environment=MAPLE_ORIGIN=https://maple.your-domain.com
# Environment=MAPLE_CORS_ORIGIN=https://maple.your-domain.com

# Restart policy
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Allow read/write to the photo library, the .maple/ cache directories, and
# /var/lib/maple, which holds the SQLite library database:
ReadWritePaths=/srv/photos /var/lib/maple

[Install]
WantedBy=multi-user.target
