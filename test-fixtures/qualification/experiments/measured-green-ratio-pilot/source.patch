+#[test]
+fn measured_green_ratio_does_not_extrapolate_isolated_green_features() {
+    for pattern in PATTERNS {
+        for target in [0, 2] {
+            for exposure in [0.01_f32, 1.0, 16.0] {
+                let centre = (10..14)
+                    .flat_map(|y| (10..14).map(move |x| y * SIDE + x))
+                    .find(|&i| sampled(pattern, i) == 1)
+                    .unwrap();
+                let mut cfa = vec![0.2 * exposure; SIDE * SIDE];
+                let mut green = vec![0.1 * exposure; SIDE * SIDE];
+                cfa[centre] = exposure;
+                green[centre] = exposure;
+                let mut image =
+                    Image::new(SIDE as u32, SIDE as u32, ColorSpace::CameraNativeLinearRgb);
+                image.pixels.fill([0.05 * exposure; 3]);
+                image.pixels[centre][1] = exposure;
+                fcs::suppress_false_colour(
+                    &mut image,
+                    &cfa,
+                    &green,
+                    SIDE,
+                    SIDE,
+                    pattern,
+                    fcs::FALSE_COLOUR_SUPPRESS_STRENGTH,
+                    [2.0 * exposure; 3],
+                );
+                assert_eq!(image.pixels[centre][1], exposure);
+                assert!((image.pixels[centre][target] - 0.2 * exposure).abs() <= 1e-6 * exposure);
+            }
+        }
+    }
+}
