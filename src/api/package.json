{
  "name": "maple-api",
  "version": "0.1.0",
  "description": "Maple Self Hosted server (Bun + Elysia + MongoDB + Indexer)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:all": "bash ../scripts/dev-self-hosted.sh",
    "start": "bun src/index.ts",
    "indexer": "bun src/indexer.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@simplewebauthn/server": "^11",
    "chokidar": "^5.0.0",
    "elysia": "^1.1.0",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "meilisearch": "^0.58.0",
    "mongodb": "^6.10.0",
    "pino": "^10.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.5.0"
  }
}
