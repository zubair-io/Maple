@@ -0,0 +1,61 @@
+//! Local diagnostic only: compare AMaZE reconstruction in native and balanced CFA domains.
+use raw_core::{decode, demosaic::amaze::amaze_with_gains, image::Image, linearize};
+use std::{error::Error, io::Write, path::Path};
+fn save(path: &Path, image: &Image) -> Result<(), Box<dyn Error>> {
+    let mut f = std::io::BufWriter::new(
+        std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(path)?,
+    );
+    for pixel in &image.pixels {
+        for v in pixel {
+            f.write_all(&v.to_le_bytes())?;
+        }
+    }
+    f.flush()?;
+    Ok(())
+}
+fn main() -> Result<(), Box<dyn Error>> {
+    let a = std::env::args().collect::<Vec<_>>();
+    if a.len() != 7 {
+        return Err("usage: amaze-mosaic-probe RAW X Y WIDTH HEIGHT NEW_OUTPUT_DIR".into());
+    }
+    let [x, y, w, h] = [
+        a[2].parse::<u32>()?,
+        a[3].parse()?,
+        a[4].parse()?,
+        a[5].parse()?,
+    ];
+    let raw = decode::decode(Path::new(&a[1]))?;
+    if !raw.cfa.is_bayer_2x2()
+        || x % 2 != 0
+        || y % 2 != 0
+        || w < 64
+        || h < 64
+        || x.checked_add(w).is_none_or(|r| r > raw.width)
+        || y.checked_add(h).is_none_or(|b| b > raw.height)
+    {
+        return Err("expected even-origin bounded Bayer region of at least64px".into());
+    }
+    let dir = Path::new(&a[6]);
+    std::fs::create_dir(dir)?;
+    let mosaic = linearize::sensor_linearize_region(&raw, x, y, w, h);
+    let min_neutral = raw
+        .as_shot_neutral
+        .into_iter()
+        .fold(f32::INFINITY, f32::min);
+    let scales = raw.as_shot_neutral.map(|n| min_neutral / n);
+    save(&dir.join("mosaic.f32"), &mosaic)?;
+    let native = amaze_with_gains(&mosaic, raw.cfa, [1.0; 3]);
+    save(&dir.join("native.f32"), &native)?;
+    let balanced = amaze_with_gains(&mosaic, raw.cfa, scales);
+    save(&dir.join("balanced.f32"), &balanced)?;
+    let identity = serde_json::json!({"origin":[x,y],"dimensions":[w,h],"as_shot_neutral":raw.as_shot_neutral,"scales":scales,"clip_point":scales.into_iter().fold(1.0_f32, f32::min),"baseline_exposure":raw.baseline_exposure,"scope":"cropped diagnostic, not full physical color gate; returns unbalanced sensor RGB after FCS"});
+    std::fs::write(
+        dir.join("identity.json"),
+        serde_json::to_string_pretty(&identity)?,
+    )?;
+    println!("{identity}");
+    Ok(())
+}
