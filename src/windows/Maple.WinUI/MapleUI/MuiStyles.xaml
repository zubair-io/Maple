<!--
  Maple.UI shared styles — the Windows control library's style sheet.
  This dictionary holds only styles consumed by the MapleUI/Atoms/*.cs
  controls. Merged into App.xaml after Themes/Tokens.xaml (the old
  hand-authored ../Themes/Styles.xaml — MapleEyebrow/MapleRowLabel/
  MapleValueChip/MapleToolButton — was retired in #3022 once MainWindow.xaml
  finished migrating onto these Mui atoms; it had zero remaining consumers).

  Colors are always {StaticResource Maple*} brushes from Themes/Tokens.xaml
  — never a literal hex value. Radius/padding/spacing are written as literal
  numbers matching the MapleRadius*/MapleSpacing* token values — a
  CornerRadius/Thickness property can't bind directly to the tokens'
  x:Double resources without a converter, so the pixel values are copied in
  by hand instead.

  KNOWN GAP: these Styles only set the base Background/Foreground/BorderBrush
  (the button.md/action-button.md "Default" state). Pointer-over/pressed
  render through the default WinUI Fluent theme's built-in hover/press
  overlay rather than a hand-tuned `color.surface_hover` swap — recoloring
  those specific states requires overriding the ButtonBackgroundPointerOver/
  ButtonBackgroundPressed/etc. theme resource keys per-control, which needs
  compiler verification this worktree can't get before CI. Flagged as a
  follow-up rather than shipped unverified.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════ MuiButton (button.md) — one Style per variant ══════════ -->

    <Style x:Key="MuiButtonPrimaryStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource MaplePrimary}" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="BorderBrush" Value="{StaticResource MaplePrimary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="MuiButtonSecondaryStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource MapleSurface}" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="BorderBrush" Value="{StaticResource MapleBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="MuiButtonGhostStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="MuiButtonDestructiveStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource MapleErrorBg}" />
        <Setter Property="Foreground" Value="{StaticResource MapleErrorText}" />
        <Setter Property="BorderBrush" Value="{StaticResource MapleErrorText}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ══════════ MuiActionButton (action-button.md) ══════════ -->
    <!-- ToggleButton, not Button: Selected maps to IsChecked, which gives the
         atom's "expose selected via a pressed/toggle state" accessibility
         requirement for free via the platform's native toggle automation
         peer, instead of hand-rolling an aria-pressed equivalent. Selected
         visuals (primary/primary_dim) are applied directly on the instance
         in MuiActionButton.cs, since they depend on the Selected property. -->
    <Style x:Key="MuiActionButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ══════════ MuiLink (link.md) ══════════ -->
    <Style x:Key="MuiLinkTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MaplePrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- ══════════ MuiText (text.md) — one Style per type-scale step ══════════ -->
    <!-- No Merriweather/Lato/JetBrains Mono asset is bundled anywhere in this
         app yet (grep across src/windows/Maple.WinUI turns up nothing but the
         "Consolas" stand-in this file's own ValueChip/Filename roles use for
         their monospace numerals) — sans/serif roles below intentionally
         leave FontFamily unset (system default) rather than reference a font
         that isn't actually available; only the two monospace roles set
         Consolas. -->
    <Style x:Key="MuiTextSourceTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-10" />
    </Style>
    <Style x:Key="MuiTextSheetTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="MuiTextRowLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="MuiTextBodyStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="MuiTextToolLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style x:Key="MuiTextChipLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="MuiTextEyebrowStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="140" />
    </Style>
    <Style x:Key="MuiTextValueChipStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="MuiTextFilenameStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ══════════ MuiTimestamp (timestamp.md) ══════════ -->
    <Style x:Key="MuiTimestampStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
