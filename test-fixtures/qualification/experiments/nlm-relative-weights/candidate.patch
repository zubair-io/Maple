@@ -0,0 +1,71 @@
+//! Correctness-first normalized Gaussian reduction. SIMD qualification pending.
+use super::fast_neg_exp;
+
+/// Keep all weights relative to the largest accepted weight (smallest
+/// exponent). Rescaling both sums cancels the common Gaussian factor and
+/// avoids an absolute center floor or underflow of all neighbor weights.
+#[inline]
+pub(super) fn add(x: f32, sample: f32, acc: &mut f32, sum: &mut f32, minimum: &mut f32) {
+    if !x.is_finite() {
+        return;
+    }
+    if x < *minimum {
+        let scale = fast_neg_exp(*minimum - x);
+        *acc *= scale;
+        *sum *= scale;
+        *minimum = x;
+    }
+    let weight = fast_neg_exp(x - *minimum);
+    *acc += weight * sample;
+    *sum += weight;
+}
+
+#[inline]
+pub(super) fn finish(acc: f32, sum: f32, center: f32) -> f32 {
+    if sum > 0.0 {
+        (acc + center) / (sum + 1.0)
+    } else {
+        center
+    }
+}
+
+pub(super) fn accumulate(
+    sums: &[f32],
+    shifted: &[f32],
+    acc: &mut [f32],
+    weights: &mut [f32],
+    minima: &mut [f32],
+    inv_norm: f32,
+) {
+    for i in 0..sums.len() {
+        add(
+            sums[i].max(0.0) * inv_norm,
+            shifted[i],
+            &mut acc[i],
+            &mut weights[i],
+            &mut minima[i],
+        );
+    }
+}
+
+pub(super) fn accumulate_dynamic(
+    sums: &[f32],
+    shifted: &[f32],
+    acc: &mut [f32],
+    weights: &mut [f32],
+    minima: &mut [f32],
+    dynamic: (&[f32], &[isize], isize),
+) {
+    let (norms, search, distance) = dynamic;
+    for i in 0..sums.len() {
+        if search[i] >= distance {
+            add(
+                sums[i].max(0.0) * norms[i],
+                shifted[i],
+                &mut acc[i],
+                &mut weights[i],
+                &mut minima[i],
+            );
+        }
+    }
+}
