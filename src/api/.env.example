# Maple Self Hosted — environment variable reference
#
# Copy this file to `.env` and adjust values as needed. The Bun server
# reads `process.env` directly; `.env` is loaded automatically by `bun run`.
# Variables documented here are the ones touched at boot or by background
# workers — see the per-route source for endpoint-specific settings.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Listen port. Default 3000.
PORT=3000

# CORS allow-origin header. Default "*".
# MAPLE_CORS_ORIGIN=https://app.example.com

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------

MAPLE_MONGO_URI=mongodb://localhost:27017
MAPLE_MONGO_DB=maple

# ---------------------------------------------------------------------------
# Filesystem roots (jail for browse + indexer)
# ---------------------------------------------------------------------------

# Colon-separated allow-list of paths the API may read from. Default "/"
# (the Docker mount is the jail). Set explicitly when running natively.
# MAPLE_ROOTS=/Users/me/Pictures:/mnt/photos

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Set to bypass passkey auth for local dev. NEVER set in production.
# MAPLE_DEV_AUTH=1

# Override the JWT secret. By default it's read from / generated at
# `./.maple/jwt.secret`.
# MAPLE_JWT_SECRET=
# MAPLE_JWT_SECRET_FILE=./.maple/jwt.secret

# ---------------------------------------------------------------------------
# Indexer (fast tier)
# ---------------------------------------------------------------------------

# Set to "0" to skip auto-starting the standalone indexer child.
# MAPLE_INDEXER_AUTOSTART=1

# Set to "1" to log per-stage diagnostics to stdout.
# MAPLE_INDEXER_VERBOSE=0

# ---------------------------------------------------------------------------
# Enrichment (slow tier)
# ---------------------------------------------------------------------------

# Base URL of a self-hosted Nominatim instance (Geofabrik extract on a
# nearby host, typically). The geocode worker reverse-geocodes EXIF GPS
# coords against this URL. Worker is skipped at boot when this is unset;
# see `docs/indexer-enrichment.md` §4.1.
# MAPLE_NOMINATIM_URL=http://nominatim.lan:8080

# Set to "false" to disable the geocode worker even when the URL is set
# (useful when running multiple Maple processes against one Nominatim and
# you want only one of them to enrich). Default on.
# MAPLE_GEOCODE_WORKER_ENABLED=true

# Sustained throttle on the Nominatim HTTP client (token-bucket refill rate
# in requests/second; per-process; burst capacity = sustained rate). The
# default 10 r/s clears a 100k-photo library in under three hours assuming
# a 70% cache-hit rate. Lower for shared / slow instances; raise for fast
# Geofabrik deployments. Range 0.1–100. Saved values from /settings/enrichment
# override this env var.
# MAPLE_NOMINATIM_RATE_LIMIT_PER_SEC=10

# ---------------------------------------------------------------------------
# Meilisearch sidecar — typo-tolerant text search (Phase 7)
# ---------------------------------------------------------------------------

# Base URL of a Meilisearch sidecar (operator-managed; latest stable v1.x).
# When set and reachable, /api/search?placeQuery=... uses Meilisearch first;
# misses and errors fall back to the Mongo $text path so the API never
# breaks because of a Meilisearch outage. When unset, every Meilisearch
# code path is a silent no-op. See `docs/operations/meilisearch.md`.
#
# Both the URL and API key can ALSO be set at runtime from Settings →
# Workers → meili (no restart). Values saved there are stored in the DB and
# take precedence over these env vars; the env vars are the fallback.
# MAPLE_MEILISEARCH_URL=http://meili.lan:7700

# Master/admin API key for the Meilisearch instance. Required if the
# operator configured Meilisearch with `--master-key`. Sent as a bearer
# token on every request. Can also be set in Settings (write-only there; a
# saved key takes precedence over this var and is stored in the DB).
# MAPLE_MEILISEARCH_API_KEY=

# Semantic (hybrid keyword + vector) search master switch. The bundled
# Docker deployment enables it when a Meilisearch URL is configured; direct
# Bun deployments must opt in explicitly.
# When `true`, ensureIndex registers a Meili-managed Ollama embedder and
# /api/search runs hybrid queries so conceptual matches ("a boy playing
# ball" → "child kicking a soccer ball") rank alongside keyword hits.
# Requires Meilisearch ≥ v1.13 with network reach to the Ollama host below.
# Misses/errors still fall back to the Mongo $text path.
# MAPLE_MEILISEARCH_SEMANTIC=false

# Ollama base URL that Meilisearch embeds against. Defaults to
# MAPLE_DESCRIBE_PROVIDER_URL when set, else http://localhost:11434. Meili
# (not Maple) makes the embedding calls, so this must be reachable FROM the
# Meilisearch host.
# MAPLE_MEILISEARCH_EMBEDDER_URL=http://localhost:11434

# Ollama embedding model id. Default `nomic-embed-text` (small, fast).
# Must be pulled on the Ollama host (`ollama pull nomic-embed-text`).
# MAPLE_MEILISEARCH_EMBEDDER_MODEL=nomic-embed-text

# Hybrid blend ratio: 0 = pure keyword, 1 = pure vector. Default 0.5.
# MAPLE_MEILISEARCH_SEMANTIC_RATIO=0.5

# ---------------------------------------------------------------------------
# OCR worker (Phase 8) — recognised text from thumbnails
# ---------------------------------------------------------------------------

# Enable the OCR worker. Off by default — first use downloads the
# tesseract `eng.traineddata` blob (~10 MB per language) and OCR is
# CPU-heavy. Saved values from /settings/enrichment override this env var.
# MAPLE_OCR_WORKER_ENABLED=false

# Comma-separated tesseract language codes. Default `eng`. Example
# multilingual setup: `eng,fra,deu`. Each additional language adds
# another traineddata download on first use.
# MAPLE_OCR_LANGUAGES=eng

# ---------------------------------------------------------------------------
# Face worker (Phase 5) — SCRFD-10G + ArcFace R100 (Glint360K) via ONNX
# ---------------------------------------------------------------------------

# Enable the face worker. Off by default — opt-in because the worker
# requires the ONNX model files on disk. Saved values from
# /settings/enrichment override this env var.
# MAPLE_FACE_WORKER_ENABLED=false

# Where the worker looks for ONNX model files. Default `~/.maple/models/`.
# In Docker set this to a path inside your mounted config volume — e.g.
# `-v /opt/maple/config:/app/.maple` plus
# `-e MAPLE_MODEL_DIR=/app/.maple/models` — so the cached models survive
# container rebuilds.
# MAPLE_MODEL_DIR=~/.maple/models

# Zero-config bootstrap: when MAPLE_FACE_WORKER_ENABLED=true and neither
# of the URL vars below is set AND no model file exists on disk, the
# loader downloads InsightFace's `antelopev2.zip` (~360 MB) from the
# project's public GitHub Release on first boot, extracts the SCRFD-10G
# detector + ArcFace R100 (Glint360K) recognizer, and caches them under
# MAPLE_MODEL_DIR as `scrfd_10g.onnx` + `arcface_r100_glint360k.onnx`.
# Subsequent boots find the files on disk and skip the download.
# Requires `unzip` in the runtime image (preinstalled on Debian and
# most Bun images). Set to `true` to disable and force the manual /
# explicit-URL path.
#
# Note: an earlier PR claimed buffalo_l ships R100 — it does not, it
# ships R50 (`w600k_r50.onnx`). antelopev2 is the bundle with the real
# R100/Glint360K weights.
# MAPLE_FACE_NO_AUTO_DOWNLOAD=false

# Override URLs: when set, the loader fetches from these URLs instead
# of the antelopev2 default. Optional SHA256 verifies the download.
# Useful when you want to pin a specific model version on a stable URL
# you control (e.g. a GitHub Release on your own repo).
# MAPLE_FACE_DETECTOR_URL=https://example.com/scrfd_10g_bnkps.onnx
# MAPLE_FACE_DETECTOR_SHA256=<hex>
# MAPLE_FACE_RECOGNIZER_URL=https://example.com/glintr100.onnx
# MAPLE_FACE_RECOGNIZER_SHA256=<hex>
#
# Legacy env vars from the v1 (buffalo_s) pipeline. Still honoured but
# the face-models loader emits a one-shot deprecation warning at boot
# because the underlying model architecture has changed (SCRFD-500m ->
# SCRFD-10G; MobileFaceNet -> ArcFace R100 trained on Glint360K) and
# the v1 URLs almost certainly point at the wrong weights for the new
# alignment path. Operators should migrate to MAPLE_FACE_DETECTOR_URL /
# MAPLE_FACE_RECOGNIZER_URL above.
# MAPLE_FACE_RETINAFACE_URL=https://example.com/retinaface.onnx
# MAPLE_FACE_RETINAFACE_SHA256=<hex>
# MAPLE_FACE_MOBILEFACENET_URL=https://example.com/mobilefacenet.onnx
# MAPLE_FACE_MOBILEFACENET_SHA256=<hex>

# ---------------------------------------------------------------------------
# Describe worker (Phase 6) — vision-LLM caption generator
# ---------------------------------------------------------------------------

# Enable the describe worker. Default true — but with no provider configured
# it stays dormant. Switch the provider via /settings/enrichment.
# MAPLE_DESCRIBE_WORKER_ENABLED=true

# Provider: one of `ollama`, `anthropic`, `openai`, `gemini`. Default
# `ollama` — local, free, no API key needed.
# MAPLE_DESCRIBE_PROVIDER=ollama

# Ollama endpoint. Only meaningful when MAPLE_DESCRIBE_PROVIDER=ollama.
# Paid providers have hard-coded endpoints.
# MAPLE_DESCRIBE_PROVIDER_URL=http://localhost:11434

# Model id for the selected provider. Defaults: ollama=`llava:latest`,
# anthropic=`claude-haiku-4-5`, openai=`gpt-4o-mini`, gemini=`gemini-flash`.
# MAPLE_DESCRIBE_MODEL=

# Caption prompt. Default focuses on subject/scene without speculating
# about identity or location.
# MAPLE_DESCRIBE_SYSTEM_PROMPT=

# Per-UTC-day spend cap in USD. The worker pauses (returns circuit-pause)
# for the rest of the day once the cap is hit. Default 5. Range 0.1–1000.
# Ignored for Ollama (cost is always reported as 0).
# MAPLE_DESCRIBE_DAILY_CAP_USD=5

# API keys for paid providers — required iff that provider is selected.
# Boot fail-fasts when the selected provider's key is missing.
# MAPLE_ANTHROPIC_API_KEY=
# MAPLE_OPENAI_API_KEY=
# MAPLE_GEMINI_API_KEY=
