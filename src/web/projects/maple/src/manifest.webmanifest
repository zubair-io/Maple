{
  "name": "Maple",
  "short_name": "Maple",
  "id": "/",
  "scope": "/",
  "start_url": "/browse",
  "display": "standalone",
  "background_color": "#1c1917",
  "theme_color": "#1c1917",
  "icons": [
    {
      "src": "assets/brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/brand/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "protocol_handlers": [{ "protocol": "web+maple", "url": "/protocol-handler?url=%s" }],
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "image/x-adobe-dng": [".dng"],
        "image/x-canon-cr2": [".cr2"],
        "image/x-canon-cr3": [".cr3"],
        "image/x-nikon-nef": [".nef"],
        "image/x-sony-arw": [".arw"],
        "image/x-fuji-raf": [".raf"],
        "image/x-olympus-orf": [".orf"],
        "image/x-panasonic-rw2": [".rw2"],
        "image/x-pentax-pef": [".pef"],
        "image/x-samsung-srw": [".srw"],
        "image/x-sigma-x3f": [".x3f"],
        "image/x-hasselblad-3fr": [".3fr"],
        "image/x-mamiya-mef": [".mef"],
        "image/x-epson-erf": [".erf"],
        "image/x-hasselblad-fff": [".fff"],
        "image/x-kodak-dcr": [".dcr"],
        "image/x-leaf-mos": [".mos"],
        "image/x-phaseone-iiq": [".iiq"],
        "image/x-minolta-mrw": [".mrw"],
        "image/x-panasonic-raw": [".raw"]
      }
    }
  ]
}
