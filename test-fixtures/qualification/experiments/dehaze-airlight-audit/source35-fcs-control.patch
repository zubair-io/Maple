+        let tied: Vec<usize> = (0..n).filter(|&i| dc[i] == threshold).collect();
+        let tie_weight = (top_n - above.len()) as f64 / tied.len() as f64;
+        let mut weighted = [0.0_f64; 3];
+        let mut tie_min = [f32::INFINITY; 3];
+        let mut tie_max = [f32::NEG_INFINITY; 3];
