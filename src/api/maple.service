# Maple Self Hosted — systemd unit file
#
# Copy to: /etc/systemd/system/maple.service
#
# After installing:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maple
#   sudo systemctl status maple
#   journalctl -fu maple

[Unit]
Description=Maple Self Hosted Server
Documentation=https://github.com/zubair.io/maple
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maple
Group=maple

# --- Edit these paths ---
WorkingDirectory=/opt/maple
ExecStart=/usr/local/bin/bun src/index.ts

# Environment
Environment=PORT=3000
Environment=MAPLE_MONGO_URI=mongodb://localhost:27017
Environment=MAPLE_MONGO_DB=maple
# Uncomment and set your photo library roots:
# Environment=MAPLE_ROOTS=/srv/photos
# Environment=MAPLE_INDEXER_WORKERS=4

# WebAuthn / passkey auth — REQUIRED in production. The browser refuses
# passkey ceremonies whose rpId/origin don't match the page hostname.
# Environment=MAPLE_RP_ID=maple.your-domain.com
# Environment=MAPLE_ORIGIN=https://maple.your-domain.com
# Environment=MAPLE_CORS_ORIGIN=https://maple.your-domain.com

# Restart policy
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Allow read/write to photo library and .maple/ cache directories:
ReadWritePaths=/srv/photos /var/lib/maple

[Install]
WantedBy=multi-user.target
