{
  "name": "maple-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build-raw-wasm": "bash ../raw-pipeline/raw-wasm/build.sh",
    "sync-raw-wasm": "bash scripts/sync-raw-wasm.sh",
    "raw-wasm": "npm run build-raw-wasm && npm run sync-raw-wasm",
    "prestart": "npm run raw-wasm",
    "prestart:hosted": "npm run raw-wasm",
    "prestart:self-hosted": "npm run raw-wasm",
    "prebuild": "npm run raw-wasm",
    "prebuild:hosted": "npm run raw-wasm",
    "prebuild:self-hosted": "npm run raw-wasm",
    "start": "npm run start:hosted",
    "start:hosted": "ng serve maple-hosted --port 4200",
    "start:self-hosted": "ng serve maple-self-hosted --port 4201",
    "build": "npm run build:hosted",
    "build:hosted": "ng build maple-hosted",
    "build:self-hosted": "ng build maple-self-hosted",
    "watch": "ng build maple-hosted --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.10",
    "@simplewebauthn/browser": "^11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.59.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
