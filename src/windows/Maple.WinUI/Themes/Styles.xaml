<!--
  Hand-authored WinUI styles — NOT touched by codegen. Distinct from
  Tokens.xaml (colors + radius + spacing), which is fully generated by
  tools/codegen.sh from src/raw-pipeline/raw-core/src/ui_tokens.rs (#606).
  These styles reference the brushes Tokens.xaml declares, so this
  dictionary must be merged after Tokens.xaml in App.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section header eyebrow text -->
    <Style x:Key="MapleEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
    </Style>

    <!-- Slider row label / value chip -->
    <Style x:Key="MapleRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
    </Style>
    <Style x:Key="MapleValueChip" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
    </Style>

    <!-- Compact toolbar icon button -->
    <Style x:Key="MapleToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource MapleBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
    </Style>
</ResourceDictionary>
