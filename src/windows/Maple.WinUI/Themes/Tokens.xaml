<!--
  Maple design tokens — values single-sourced from
  src/raw-pipeline/raw-core/src/ui_tokens.rs (#606). A `winui` codegen emit
  target should replace this hand-mirrored copy (tracked in milestone #22's
  parity ticket); until then any ui_tokens.rs change must be reflected here.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="MapleBgColor">#1C1917</Color>
    <Color x:Key="MapleSurfaceColor">#262524</Color>
    <Color x:Key="MapleSurfaceAltColor">#2E2C2A</Color>
    <Color x:Key="MapleSurfaceHoverColor">#3A3836</Color>
    <Color x:Key="MapleSidebarColor">#292524</Color>
    <Color x:Key="MapleInputBgColor">#1C1917</Color>
    <Color x:Key="MapleImageCanvasColor">#141210</Color>
    <Color x:Key="MapleTextMainColor">#E7E5E4</Color>
    <Color x:Key="MapleTextMutedColor">#A8A29E</Color>
    <Color x:Key="MapleBorderColor">#44403C</Color>
    <Color x:Key="MapleBorderHiColor">#5A5552</Color>
    <Color x:Key="MaplePrimaryColor">#C4493A</Color>
    <Color x:Key="MaplePrimaryDimColor">#422016</Color>
    <Color x:Key="MapleWarnColor">#FBBF24</Color>
    <Color x:Key="MapleStarColor">#EF9F27</Color>

    <SolidColorBrush x:Key="MapleBg" Color="{StaticResource MapleBgColor}" />
    <SolidColorBrush x:Key="MapleSurface" Color="{StaticResource MapleSurfaceColor}" />
    <SolidColorBrush x:Key="MapleSurfaceAlt" Color="{StaticResource MapleSurfaceAltColor}" />
    <SolidColorBrush x:Key="MapleSurfaceHover" Color="{StaticResource MapleSurfaceHoverColor}" />
    <SolidColorBrush x:Key="MapleSidebar" Color="{StaticResource MapleSidebarColor}" />
    <SolidColorBrush x:Key="MapleInputBg" Color="{StaticResource MapleInputBgColor}" />
    <SolidColorBrush x:Key="MapleImageCanvas" Color="{StaticResource MapleImageCanvasColor}" />
    <SolidColorBrush x:Key="MapleTextMain" Color="{StaticResource MapleTextMainColor}" />
    <SolidColorBrush x:Key="MapleTextMuted" Color="{StaticResource MapleTextMutedColor}" />
    <SolidColorBrush x:Key="MapleBorder" Color="{StaticResource MapleBorderColor}" />
    <SolidColorBrush x:Key="MapleBorderHi" Color="{StaticResource MapleBorderHiColor}" />
    <SolidColorBrush x:Key="MaplePrimary" Color="{StaticResource MaplePrimaryColor}" />
    <SolidColorBrush x:Key="MaplePrimaryDim" Color="{StaticResource MaplePrimaryDimColor}" />
    <SolidColorBrush x:Key="MapleWarn" Color="{StaticResource MapleWarnColor}" />
    <SolidColorBrush x:Key="MapleStar" Color="{StaticResource MapleStarColor}" />
    <SolidColorBrush x:Key="MapleBgHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="MapleBgActive" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="MapleErrorText" Color="#F87171" />
    <SolidColorBrush x:Key="MapleSuccessText" Color="#4ADE80" />

    <!-- Section header eyebrow text -->
    <Style x:Key="MapleEyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="140" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
    </Style>

    <!-- Slider row label / value chip -->
    <Style x:Key="MapleRowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
    </Style>
    <Style x:Key="MapleValueChip" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMuted}" />
    </Style>

    <!-- Compact toolbar icon button -->
    <Style x:Key="MapleToolButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource MapleBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="{StaticResource MapleTextMain}" />
    </Style>
</ResourceDictionary>
