{
	"name": "maple-thumb-cache",
	"version": "0.0.0",
	"private": true,
	"description": "Cloudflare Worker fronting /api/thumb/* with an R2 edge cache (#1757, #1760)",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"postinstall": "node scripts/patch-jsquash.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
