{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["scripts/serve-production-e2e.ts"],
  // Generated mirrors (tools/codegen.sh, #2683) are drift-gated against
  // their Rust source by the codegen-drift CI job, not usage-gated — a
  // generated file with no web consumer yet (e.g. a catalog whose picker
  // UI lands in a later stacked PR) is not dead code, it's staged output.
  // Auditing them for unused-file/unused-export dead code is a category
  // error, so they're excluded here the same way _design-reference/** is.
  "ignorePatterns": [
    "_design-reference/**",
    "projects/**/*.generated.ts",
    "projects/**/generated/**"
  ],
  // The four entries after `fallow` are pre-existing package.json hygiene
  // findings (never-imported deps / test-only placement) tracked in #3002 —
  // suppressed so unrelated PRs that touch package.json don't gate on them.
  // Remove each suppression in the PR that fixes it.
  "ignoreDependencies": [
    "@socketsecurity/bun-security-scanner",
    "fallow",
    "@opentelemetry/sdk-trace-base",
    "@opentelemetry/core",
    "@angular/animations",
    "@compodoc/compodoc",
    "@angular/compiler"
  ],
  // Maple UI atoms (#3000) live two levels below `lib/` (`lib/ui/<name>/`)
  // and `@use '../../generated/ui-tokens' as tok;` per the wave brief.
  // fallow's Sass import resolver doesn't walk multi-segment `../../`
  // traversals — the single-segment sibling import in tokens.scss/
  // motion.scss already resolves fine — but the real Sass compiler (and the
  // actual `ng build`/`ng test` runs) resolve it correctly, confirmed by a
  // clean maple-syrup production build. False positive, not a real gap.
  "ignoreUnresolvedImports": [
    "**/pkg/raw_wasm",
    "tailwindcss",
    "**/tailwindcss",
    "**/generated/ui-tokens"
  ]
}
