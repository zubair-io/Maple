# macOS
.DS_Store

# Test fixtures — local-only, 6.5GB of RAWs and ACR reference PNGs.
# See docs/spec/11-testing.md and test-fixtures/references/REFERENCES.md
# for how to regenerate or fetch these locally.
test-fixtures/*
# Exception: the per-case ΔE budget table IS committed (it's the CI ratchet).
!test-fixtures/budgets.json

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# wasm-pack / wasm-bindgen output
src/raw-pipeline/raw-wasm/pkg/

# raw-wasm synced into maple-common (rebuilt via scripts/sync-raw-wasm.sh)
src/web/projects/maple-common/src/lib/raw-pipeline/pkg/

# Swift / SPM
.build/
.swiftpm/
**/xcuserdata/
**/xcuserstate
xcuserdata/
DerivedData/

# Rust .a binaries inside committed xcframeworks — too large for GitHub
# (200-500 MB each). Rebuild via ./src/apple/scripts/build-xcframework.sh
# after a fresh clone. The framework's Headers/, Info.plist, and
# module.modulemap stay tracked. The `*.xcframework/**/…` glob form used
# earlier didn't actually match for older git versions — anchor the
# pattern explicitly instead.
libraw_ffi.a

# Node / Bun
node_modules/
.bun/
dist/
.next/
npm-debug.log
yarn-error.log
out-tsc/
bazel-out/

# Angular
.angular/
.sass-cache/
coverage/
testem.log
__screenshots__/

# Editor
.idea/
.vscode/
*.swp

# Claude Code / agent tooling
.claude/
.worktrees/

# Playwright test output (src/web/e2e runs)
test-results/
playwright-report/

# Python bytecode cache (ACR reference scripts, codegen helpers)
__pycache__/
*.pyc
.env

# Build-stamp markers from build-xcframework.sh — regenerated on every build.
src/apple/Frameworks/.xcframework-stamp.*

