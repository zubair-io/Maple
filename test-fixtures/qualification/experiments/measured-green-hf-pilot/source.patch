+#[test]
+fn measured_green_hf_does_not_follow_reconstructed_green_overshoot() {
+    for pattern in PATTERNS {
+        for exposure in [0.01_f32, 1.0, 16.0] {
+            let mut out = Image::new(SIDE as u32, SIDE as u32, ColorSpace::CameraNativeLinearRgb);
+            let mut cfa = vec![0.0; SIDE * SIDE];
+            let mut green = vec![0.0; SIDE * SIDE];
+            for i in 0..SIDE * SIDE {
+                let c = sampled(pattern, i);
+                cfa[i] = [0.4, 0.5, 0.3][c] * exposure;
+                green[i] = if c == 1 { 0.5 } else { 1.0 } * exposure;
+                out.pixels[i] = [0.2 * exposure, green[i], 0.1 * exposure];
+                out.pixels[i][c] = cfa[i];
+            }
+            let before = out.pixels.clone();
+            fcs::suppress_false_colour(&mut out, &cfa, &green, SIDE, SIDE, pattern,
+                fcs::FALSE_COLOUR_SUPPRESS_STRENGTH);
+            for y in 3..SIDE-3 {
+                for x in 3..SIDE-3 {
+                    let i = y * SIDE + x;
+                    if sampled(pattern, i) == 1 {
+                        assert_eq!(out.pixels[i], before[i],
+                            "{pattern:?} exposure={exposure} ({x},{y}): reconstructed green must not invent a measured-green edge");
+                    }
+                }
+            }
+        }
+    }
+}
