<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Mirrors Maple TV's own entitlements, and for the same reasons — this
	  extension reads the paired server, its token, and the selected library
	  through the very same shared storage the app writes them to:
	  - keychain-access-groups: TokenStore's non-macOS path always requests
	    this shared access group. Without it the extension cannot read the
	    bearer token, so every authenticated fetch fails silently.
	  - application-groups: CloudServerRegistry.shared is backed by
	    appGroupDefaults(), and the Top Shelf image cache lives in this
	    container — the extension hands tvOS file:// URLs into it, because
	    the system fetches item images in its own process and cannot carry
	    our bearer token.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.justmaple.aperture.shared</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.justmaple.aperture</string>
	</array>
</dict>
</plist>
