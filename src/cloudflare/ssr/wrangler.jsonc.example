/**
 * Copy this file to `wrangler.jsonc` (gitignored — it holds account/domain-
 * specific values, e.g. the route/zone below) and fill in the placeholders.
 * Run `npm run cf-typegen` afterward to regenerate
 * worker-configuration.d.ts (also gitignored) against your config.
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "maple-hosted-ssr",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,

	/**
	 * Public base URL of the Azure Blob Storage container that
	 * `.github/workflows/deploy-hosted.yml` uploads `dist/maple-syrup/browser`
	 * into. Must be reachable from Cloudflare's edge (a public hostname).
	 */
	"vars": {
		"ORIGIN_BASE_URL": "https://hornbeam.blob.core.windows.net/mapleaperture",
	},

	/**
	 * Assign this standalone Worker to the production Hosted custom domain.
	 * The existing dashboard `ssr` also serves other domains; preserve those
	 * assignments when moving mapleaperture.com. Needs a
	 * Cloudflare-managed zone for that domain. Uncomment once you have one:
	 * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
	 */
	// "routes": [{ "pattern": "mapleaperture.com", "custom_domain": true }],

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
}
