{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["scripts/serve-production-e2e.ts"],
  // Generated mirrors (tools/codegen.sh, #2683) are drift-gated against
  // their Rust source by the codegen-drift CI job, not usage-gated — a
  // generated file with no web consumer yet (e.g. a catalog whose picker
  // UI lands in a later stacked PR) is not dead code, it's staged output.
  // Auditing them for unused-file/unused-export dead code is a category
  // error, so they're excluded here the same way _design-reference/** is.
  "ignorePatterns": [
    "_design-reference/**",
    "projects/**/*.generated.ts",
    "projects/**/generated/**"
  ],
  // #2149: fallow's complexity metric is calibrated for functions — every
  // `@if`/`@for` block in an Angular container template counts as a branch,
  // so template CRAP/cyclomatic/cognitive scores run 40-100x the function
  // thresholds regardless of decomposition (measured on people.component.html:
  // CRAP 4422 vs. threshold 30, even after extracting the entire list view).
  // Templates get no realistic ceiling under this metric, so they're excluded
  // from complexity analysis only — dead-code and duplicate-detection still
  // run over .html files, since both have caught real issues on this repo.
  "health": {
    "ignore": ["**/*.html"]
  },
  // The four entries after `fallow` are pre-existing package.json hygiene
  // findings (never-imported deps / test-only placement) tracked in #3002 —
  // suppressed so unrelated PRs that touch package.json don't gate on them.
  // Remove each suppression in the PR that fixes it.
  "ignoreDependencies": [
    "@socketsecurity/bun-security-scanner",
    "fallow",
    "@opentelemetry/sdk-trace-base",
    "@opentelemetry/core",
    "@angular/animations",
    "@compodoc/compodoc",
    "@angular/compiler",
    // Pre-existing on main (verified against the toast-sweep branch's
    // merge-base, fdf1b267c — `app-update.service.ts` imports it at the
    // same line there too) despite being listed in package.json's
    // dependencies. fallow's `--gate all` still flags it because this
    // finding's own file (app-update.service.ts) is touched by the toast
    // sweep (ticket #3043) — not because the dependency itself changed.
    "@angular/service-worker"
  ],
  // Maple UI atoms (#3000) live two levels below `lib/` (`lib/ui/<name>/`)
  // and `@use '../../generated/ui-tokens' as tok;` per the wave brief.
  // fallow's Sass import resolver doesn't walk multi-segment `../../`
  // traversals — the single-segment sibling import in tokens.scss/
  // motion.scss already resolves fine — but the real Sass compiler (and the
  // actual `ng build`/`ng test` runs) resolve it correctly, confirmed by a
  // clean maple-syrup production build. False positive, not a real gap.
  "ignoreUnresolvedImports": [
    "**/pkg/raw_wasm",
    "tailwindcss",
    "**/tailwindcss",
    "**/generated/ui-tokens"
  ]
}
